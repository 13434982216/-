          "content": {
            "size": 3022,
            "mimeType": "application/javascript",
            "text": "var GOAL_REWARD = 15;\nvar GOALS = [\n  { id: 'streak3', key: 'combo', value: 3, tier: 0, text: 'Deliver 3 in a row', short: '3 in a row' },\n  { id: 'score3k', key: 'score', value: 3000, tier: 0, text: 'Score 3 000' },\n  { id: 'shift2', key: 'shift', value: 2, tier: 0, text: 'Reach shift 2', short: 'Shift 2' },\n  { id: 'deliver8', key: 'delivered', value: 8, tier: 0, text: 'Deliver 8 orders', short: '8 orders' },\n  { id: 'streak5', key: 'combo', value: 5, tier: 1, text: 'Deliver 5 in a row', short: '5 in a row' },\n  { id: 'leaks2', key: 'patched', value: 2, tier: 1, text: 'Patch 2 leaks' },\n  { id: 'score8k', key: 'score', value: 8000, tier: 1, text: 'Score 8 000' },\n  { id: 'shift3', key: 'shift', value: 3, tier: 1, text: 'Survive shift 3', short: 'Shift 3' },\n  { id: 'revived', key: 'revived', value: 1, tier: 1, text: 'Flush and carry on', short: 'Flush once' },\n  { id: 'tool1', key: 'tools', value: 1, tier: 1, text: 'Use a tool', short: 'One tool' },\n  { id: 'streak6', key: 'combo', value: 6, tier: 2, text: 'Max streak ×4' },\n  { id: 'recipe1', key: 'recipes', value: 1, tier: 2, text: 'Complete a recipe', short: 'One recipe' },\n  { id: 'score20k', key: 'score', value: 20000, tier: 2, text: 'Score 20 000' },\n  { id: 'shift5', key: 'shift', value: 5, tier: 2, text: 'Survive shift 5', short: 'Shift 5' },\n  { id: 'deliver30', key: 'delivered', value: 30, tier: 2, text: 'Deliver 30 orders', short: '30 orders' }\n];\n\nfunction goalsTier(doneCount) { return doneCount >= 24 ? 2 : (doneCount >= 6 ? 1 : 0); }\n\nfunction goalsPick(seed, tier) {\n  var rng = seededRandom(seed * 7 + 11), pool = [], out = [], keys = {}, i, j, g;\n  for (i = 0; i < GOALS.length; i++) if (GOALS[i].tier === tier) pool.push(GOALS[i]);\n  for (i = pool.length - 1; i > 0; i--) { j = Math.floor(rng() * (i + 1)); g = pool[i]; pool[i] = pool[j]; pool[j] = g; }\n  for (i = 0; i < pool.length && out.length < 3; i++) {\n    if (keys[pool[i].key]) continue; keys[pool[i].key] = 1;\n    out.push({ id: pool[i].id, key: pool[i].key, value: pool[i].value, text: pool[i].text,\n              short: pool[i].short || pool[i].text, done: false, at: 0 });\n  }\n  return out;\n}\n\nfunction goalsHave(run, key) {\n  if (key === 'combo') return run.bestCombo || 0;\n  if (key === 'score') return run.score || 0;\n  if (key === 'shift') return run.shift || 1;\n  if (key === 'delivered') return run.delivered || 0;\n  if (key === 'revived') return (run.revives || 0) >= 1 ? 1 : 0;\n  if (key === 'patched') return run.patched || 0;\n  if (key === 'recipes') return run.recipes || 0;\n  if (key === 'tools') { var u = run.toolUses || {}, s = 0, k; for (k in u) s += u[k]; return s; }\n  return 0;\n}\n\nfunction goalsProgress(run, g) { return { have: goalsHave(run, g.key), need: g.value }; }\n\nfunction goalsStep(run, goals) {\n  var done = [], i;\n  for (i = 0; i < goals.length; i++) {\n    if (goals[i].done) continue;\n    if (goalsHave(run, goals[i].key) >= goals[i].value) { goals[i].done = true; goals[i].at = run.t; done.push(goals[i].id); }\n  }\n  return done;\n}\n"
