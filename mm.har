            "mimeType": "application/javascript",
            "text": "if (typeof document !== 'undefined') {\n\n  var SAVE_KEY = 'slimeworks_save';\n\n  var cur = { grid: null, flow: null };\n\n  var save = {};\n\n  function slimeStore() {\n    var w = typeof window !== 'undefined' ? window : null;\n    return w && w.slimeNetStore ? w.slimeNetStore : localStorage;\n  }\n\n  function loadSave() {\n    var raw = null, st = null;\n    try { st = slimeStore(); raw = st.getItem(SAVE_KEY); } catch (e) { raw = null; }\n    if (raw == null && st && st !== localStorage) {\n      try {\n        raw = localStorage.getItem(SAVE_KEY);\n        if (raw != null) st.setItem(SAVE_KEY, raw);\n      } catch (e) { raw = null; }\n    }\n    try { save = JSON.parse(raw) || {}; } catch (e) { save = {}; }\n    if (!save || typeof save !== 'object') save = {};\n  }\n\n  function persist() {\n    try { slimeStore().setItem(SAVE_KEY, JSON.stringify(save)); } catch (e) {}\n  }\n\n}\n"
