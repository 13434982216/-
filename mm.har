chEnter();\n  var st = coachStep();\n  if (st && st.by === 'start' && typeof lessonCheer === 'function') lessonCheer();\n}\n\nfunction coachPipe() {\n  var st = coachStep();\n  if (!st || st.pipe == null || !scene.lesson) return null;\n  var o = slimeLessonOrder(scene.run, st.vat);\n  if (o && o.need != null && cur.flow[o.r][o.c][0] === o.need) return null;\n  return SLIME_LESSON.pipes[st.pipe];\n}\n\nfunction coachPipeAt(r, c) {\n  var st = coachStep(), p = st && st.pipe != null ? SLIME_LESSON.pipes[st.pipe] : null;\n  return !!p && p.r === r && p.c === c;\n}\n\nfunction coachSignal(why, i) {\n  var st = coachStep();\n  if (!st || why !== st.by) return;\n  if (why === 'delivered' && scene.run.orders[i] !== slimeLessonOrder(scene.run, st.vat)) return;\n  coachNext();\n}\n\nfunction coachWatch() {\n  var st = coachStep();\n  if (!st || st.by !== 'routed') return;\n  var o = slimeLessonOrder(scene.run, st.vat);\n  if (o && o.need != null && cur.flow[o.r][o.c][0] === o.need) coachNext();\n}\n\nfunction coachFinish(done) {\n  scene.coach.step = COACH_STEPS.length;\n  save.tutorialDone = true;\n  save.coachDone = true;\n  if (done && save.hints) { save.hints.deliver = 1; save.hints.sump = 1; save.hints.mix = 1; }\n  persist();\n  slimeLessonLeave();\n}\n\nfunction coachSkip() {\n  if (!coachOn()) return;\n  coachFinish(coachStep().by === 'start');\n  sfxTurn();\n}\n\nfunction slimeLessonBegin() {\n  sceneGo('run');\n  slimeStart(0, slimeLessonBoard(0));\n  nextBoard = null; lastT = 0; coachStart(); slimeHum(true, 1);\n  pumpKick = 1; sfxPumpsOn();\n}\n\nfunction slimeLessonLeave() {\n  slimeStart((Math.random() * 1e6) | 0);\n  nextBoard = null; lastT = 0;\n  coachStart();\n  scene.banner = { at: performance.now(), text: 'SHIFT 1', sub: '' };\n  slimeToolHint(); slimeHum(true, 1);\n  pumpKick = 1; sfxPumpsOn(); sfxShift();\n}\n\nfunction slimeHint(kind, need) {\n  if (coachOn()) return;\n  if (!save.hints || save.hints[kind]) return;\n  save.hints[kind] = 1; persist();\n  scene.hint = { kind: kind, at: performance.now(), need: need || null };\n}\n\nfunction slimeShotActive() {\n  for (var k in SLIME_SHOT) if (Object.prototype.hasOwnProperty.call(SLIME_SHOT, k)) return true;\n  return false;\n}\n\nfunction slimeFinishRun() {\n  var run = scene.run;\n  run.goalsDone = 0;\n  for (var gk = 0; gk < scene.goals.length; gk++) if (scene.goals[gk].done) run.goalsDone++;\n  var base = shopEarned(run.score);\n  run.earned = base;\n  save.goo += Math.max(0, base - (run.paidBase || 0));\n  run.paidBase = base;\n  run.overShownAt = performance.now();\n  if (!run.runCounted) { save.slimeRuns++; run.runCounted = true; }\n  var wasRank = rankOf(save.xp || 0);\n  save.xp = (save.xp || 0) + Math.max(0, run.score - (run.paidXp || 0));\n  run.paidXp = run.score;\n  if (rankOf(save.xp) > wasRank) { run.rankUp = RANKS[rankOf(save.xp)].name; save.goo += 50; }\n  if (scene.daily) {\n    var dk = slimeDailyKey();\n    if (!save.daily || save.daily.key !== dk) save.daily = { key: dk, best: 0 };\n    if (run.score > save.daily.best) save.daily.best = run.score;\n  }\n  run.prevBest = save.slimeBest || 0;\n  if (run.score > save.slimeBest) {\n    save.slimeBest = run.score;\n    save.bestShifts = run.shift || slimeShift(run);\n  }\n  if (!slimeShotActive()) persist();\n  run.overShownAt = performance.now() + OVER_DELAY_MS;\n  scene.overBtns = null;\n  scene.armTool = null;\n  sceneGo('over');\n}\n\nfunction sfxPumpsOn() {\n  thump(55, 0.5, 0.7);\n  noiseBurst(0.6, 120, 900, 0.35, 'lowpass', 0.05);\n  tone(110, 0.5, 'sawtooth', 0.12, 165, 0.1);\n}\n\nvar beds = null;\n\nfunction buildBeds() {\n  var bus = audioBus();\n  if (!bus) return null;\n  var t = audioCtx.currentTime, b = {};\n  try {\n    b.out = audioCtx.createGain();\n    b.out.gain.setValueAtTime(0.0001, t);\n    b.out.gain.exponentialRampToValueAtTime(1, t + 0.5);\n    b.out.connect(bus);\n\n    b.sub = audioCtx.createOscillator(); b.sub.type = 'sawtooth';\n    b.sub.frequency.setValueAtTime(48, t);\n    b.subLp = audioCtx.createBiquadFilter(); b.subLp.type = 'lowpass';\n    b.subLp.frequency.setValueAtTime(320, t);\n    b.subG = audioCtx.createGain(); b.subG.gain.setValueAtTime(0.0225, t);\n    b.sub.connect(b.subLp); b.subLp.connect(b.subG); b.subG.connect(b.out);\n    b.sub.start(t);\n\n    b.lfo = audioCtx.createOscillator(); b.lfo.type = 'sine';\n    b.lfo.frequency.setValueAtTime(1.1, t);\n    b.lfoG = audioCtx.createGain(); b.lfoG.gain.setValueAtTime(0.028, t);\n    b.lfo.connect(b.lfoG); b.lfoG.connect(b.subG.gain);\n    b.lfo.start(t);\n\n    b.flow = audioNoise();\n    b.flowBp = audioCtx.createBiquadFilter(); b.flowBp.type = 'bandpass';\n    b.flowBp.frequency.setValueAtTime(600, t); b.flowBp.Q.setValueAtTime(0.7, t);\n    b.flowG = audioCtx.createGain(); b.flowG.gain.setValueAtTime(0.005, t);\n    b.flow.connect(b.flowBp); b.flowBp.connect(b.flowG); b.flowG.connect(b.out);\n    b.flow.start(t);\n\n    b.grimeA = audioCtx.createOscillator(); b.grimeA.type = 'sawtooth';\n    b.grimeB = audioCtx.createOscillator(); b.grimeB.type = 'sawtooth';\n    b.grimeA.frequency.setValueAtTime(73, t);\n    b.grimeB.frequency.setValueAtTime(75.7, t);\n    b.grimeLp = audioCtx.createBiquadFilter(); b.grimeLp.type = 'lowpass';\n    b.grimeLp.frequency.setValueAtTime(600, t);\n    b.grimeG = audioCtx.createGain(); b.grimeG.gain.setValueAtTime(0.0001, t);\n    b.grimeA.connect(b.grimeLp); b.grimeB.connect(b.grimeLp);\n    b.grimeLp.connect(b.grimeG); b.grimeG.connect(b.out);\n    b.grimeA.start(t); b.grimeB.start(t);\n\n    b.shine = audioCtx.createOscillator(); b.shine.type = 'triangle';\n    b.shine.frequency.setValueAtTime(432, t);\n    b.shineG = audioCtx.createGain(); b.shineG.gain.setValueAtTime(0.00005, t);\n    b.shine.connect(b.shineG); b.shineG.connect(b.out);\n    b.shine.start(t);\n  } catch (e) { return null; }\n  return b;\n}\n\nfunction stopBeds() {\n  var b = beds, t = audioCtx.currentTime;\n  beds = null;\n  if (!b) return;\n  try {\n    b.out.gain.setTargetAtTime(0.0001, t, 0.09);\n    var srcs = [b.sub, b.lfo, b.flow, b.grimeA, b.grimeB, b.shine];\n    for (var i = 0; i < srcs.length; i++) if (srcs[i]) srcs[i].stop(t + 0.6);\n  } catch (e) {}\n}\n\nfunction slimeHum(on, rate, run) {\n  if (!audioCtx) return;\n  if (!on) { if (beds) stopBeds(); return; }\n  if (!beds) beds = buildBeds();\n  if (!beds || !rate) return;\n  var t = audioCtx.currentTime, k = 0.3, b = beds;\n  var contam = run ? run.contam : 0;\n  var mult = run ? slimeMult(run) : 1;\n  try {\n    b.sub.frequency.setTargetAtTime(40 + rate * 26, t, k);\n    b.subG.gain.setTargetAtTime((0.036 + rate * 0.010) * 0.5, t, k);\n    b.subLp.frequency.setTargetAtTime(240 + rate * 190, t, k);\n    b.lfo.frequency.setTargetAtTime(0.8 + rate * 0.9, t, k);\n    b.flowBp.frequency.setTargetAtTime(420 + rate * 520, t, k);\n    b.flowG.gain.setTargetAtTime((0.007 + rate * 0.015) * 0.5, t, k);\n    b.grimeG.gain.setTargetAtTime(0.0001 + 0.055 * Math.pow(contam, 1.6), t, 0.5);\n    b.grimeLp.frequency.setTargetAtTime(500 + 900 * contam, t, 0.5);\n    b.shine.frequency.setTargetAtTime((40 + rate * 26) * 6, t, k);\n    b.shineG.gain.setTargetAtTime((mult > 1 ? 0.006 + 0.010 * Math.min(1, (mult - 1) / 3) : 0.0001) * 0.5, t, 0.4);\n  } catch (e) {}\n}\n\nfunction sfxDeliver(combo) {\n  var base = 320 + Math.min(6, combo) * 40;\n  tone(base, 0.16, 'sine', 0.5, base * 0.55);\n  noiseBurst(0.06, 900, 1600, 0.22, 'bandpass', 0.02);\n  if (combo >= 3) tone(base * 2, 0.09, 'triangle', 0.22, base * 2.2, 0.05);\n}\nfunction sfxExpire() { tone(420, 0.12, 'triangle', 0.35, 260); tone(300, 0.14, 'triangle', 0.3, 180, 0.11); }\nfunction sfxBurst() {\n  noiseBurst(0.9, 60, 4000, 0.9, 'lowpass');\n  thump(70, 0.6, 0.9);\n  noiseBurst(0.35, 1500, 6000, 0.4, 'highpass', 0.03);\n}\nfunction sfxCash() { tone(1320, 0.05, 'square', 0.3, 1320); tone(1760, 0.09, 'square', 0.3, 1760, 0.05); }\nfunction sfxBest() {\n  var notes = [523, 659, 784, 1047], i;\n  for (i = 0; i < notes.length; i++) tone(notes[i], 0.14, 'triangle', 0.4, notes[i], i * 0.08);\n  noiseBurst(0.2, 3000, 8000, 0.15, 'highpass', 0.3);\n}\nvar wrongAt = 0;\nfunction sfxWrong(now) {\n  if (now - wrongAt < 640) return; wrongAt = now;\n  thump(110, 0.14, 0.45);\n  noiseBurst(0.08, 300, 500, 0.2, 'lowpass');\n}\nfunction sfxAlarm() { tone(880, 0.18, 'square', 0.2, 880); tone(880, 0.18, 'square', 0.2, 880, 0.26); }\nfunction sfxTurn() {\n  noiseBurst(0.035, 2200, 3600, 0.55, 'bandpass');\n  tone(1900, 0.03, 'square', 0.18, 1400);\n}\nfunction sfxUi() { tone(1200, 0.025, 'square', 0.12, 900); }\nfunction sfxShift() { tone(392, 0.12, 'triangle', 0.35, 392); tone(523, 0.16, 'triangle', 0.35, 523, 0.1); }\nfunction sfxSwapWarn() { tone(660, 0.08, 'square', 0.18, 660); tone(660, 0.08, 'square', 0.18, 660, 0.14); }\nfunction sfxSwap() { noiseBurst(0.18, 400, 2400, 0.4, 'bandpass'); tone(240, 0.2, 'sine', 0.4, 480); }\nfunction sfxRush() { tone(988, 0.06, 'square', 0.22, 988); tone(1319, 0.08, 'square', 0.22, 1319, 0.07); }\nfunction sfxLocked() {\n  thump(140, 0.09, 0.5);\n  noiseBurst(0.03, 600, 900, 0.25, 'bandpass', 0.01);\n}\nfunction sfxPurge() { noiseBurst(0.5, 200, 1800, 0.5, 'bandpass'); tone(180, 0.4, 'sine', 0.4, 90, 0.05); }\nfunction sfxHold() { tone(523, 0.06, 'triangle', 0.3, 523); tone(659, 0.08, 'triangle', 0.3, 659, 0.07); }\nfunction sfxHoldTick() { tone(880, 0.02, 'square', 0.08, 880); }\nfunction sfxDrain() { noiseBurst(0.6, 150, 900, 0.35, 'bandpass'); tone(220, 0.5, 'sine', 0.3, 90, 0.05); }\nfunction sfxPatch() {\n  noiseBurst(0.04, 2000, 3000, 0.4, 'bandpass');\n  noiseBurst(0.04, 2000, 3000, 0.4, 'bandpass', 0.07);\n}\nfunction sfxRecipe() {\n  tone(880, 0.05, 'square', 0.28, 880);\n  tone(1175, 0.05, 'square', 0.28, 1175, 0.06);\n  tone(1568, 0.09, 'square', 0.3, 1568, 0.12);\n}\n\nfunction slimeTileAt(px, py) {\n  var c = Math.floor((px - ox) / tile), r = Math.floor((py - oy) / tile);\n  if (r < 0 || r >= cur.grid.length || c < 0 || c >= cur.grid[0].length) return null;\n  return { r: r, c: c };\n}\n\nfunction slimeRotate(r, c, dir) {\n  var t = cur.grid[r][c];\n  if (t.leak) {\n    if (slimeLeakPatch(scene.run, t)) {\n      turnRefuse(r, c, dir, performance.now());\n      var pcx = ox + (c + 0.5) * tile, pcy = oy + (r + 0.5) * tile;\n      spawnDrops(pcx, pcy, VIEW.metal, 8, 0.8);\n      scene.patchAt = { r: r, c: c, at: performance.now() };\n      sfxPatch();\n    }\n    return;\n  }\n  if (t.fixed || t.type === 'empty' || t.type === 'source' || t.type === 'output') {\n    if (t.type === 'empty') SHAKE = Math.max(SHAKE, 1.5);\n    else turnRefuse(r, c, dir, performance.now());\n    sfxLocked();\n    return;\n  }\n  if (scene.lesson && coachOn() && !coachPipeAt(r, c)) {\n    turnRefuse(r, c, dir, performance.now());\n    sfxLocked();\n    return;\n  }\n  t.rot = ((t.rot + dir) % 4 + 4) % 4;\n  slimeTouch(scene.run, r, c);\n  turnKick(r, c, dir, performance.now());\n  scene.tapAt = { r: r, c: c, at: performance.now() };\n  cur.flow = computeFlow(cur.grid);\n  slimeViaLast(cur.grid, scene.run);\n  scene.reachJob = null;\n  noteFlow(performance.now());\n  if (coachOn()) coachWatch();\n  sfxTurn();\n}\n\nfunction hitBox(b, x, y) { return b && x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h; }\n\nfunction slimeReviveKind() {\n  var run = scene.run, have = shopHave(save, 'purge');\n  if ((run.revives || 0) < (run.freeFlushes || 1)) return { by: 'ad', kind: 'go', label: slimeAdsRewarded() ? 'WATCH AD  \\u2014  FLUSH' : 'FLUSH  \\u2014  CONTINUE' };\n  if ((run.revives || 0) >= SHOP_REVIVE_MAX) return { by: null, kind: 'off', label: 'NO FLUSH LEFT' };\n  if (have > 0) return { by: 'item', kind: 'go', label: 'USE FLUSH  \\u00d7' + have };\n  return { by: null, kind: 'off', label: 'FLUSH USED' };\n}\n\nfunction slimeRevive() {\n  var rv = slimeReviveKind();\n  if (!rv.by) return;\n  if (rv.by === 'item') {\n    if (!shopSpendItem(save, 'purge')) return;\n    persist();\n    slimeReviveGrant();\n    return;\n  }\n  var run = scene.run;\n  var tok = (run.reviveToken = (run.reviveToken || 0) + 1);\n  SLIME_ADS.revive(function () { slimeReviveGrant(tok); });\n}\n\nfunction slimeDouble() {\n  var run = scene.run;\n  if (run.doubled) return;\n  SLIME_ADS.doubleReward(function () {\n    if (run.doubled) return;\n    run.doubled = true;\n    save.goo += run.earned;\n    persist();\n    walletSplash(VIEW.goo.G);\n    sfxCash();\n  });\n}\n\nfunction slimeReviveGrant(tok) {\n  var run = scene.run;\n  if (!run.over) return;\n  if (tok != null && run.reviveToken !== tok) return;\n  run.reviveToken = (run.reviveToken || 0) + 1;\n  run.reviveUsed = true;\n  run.revives = (run.revives || 0) + 1;\n  run.over = false;\n  scene.armTool = null;\n  slimePurge(run, 0.75);\n  for (var i = 0; i < run.orders.length; i++) run.orders[i].ttl = slimeTtl(run);\n  sceneGo('run');\n  lastT = 0;\n  FLASH = 0.5; FLASH_HEX = VIEW.goo.G;\n  sfxPurge();\n  for (var d = 0; d < 26; d++)\n    spawnDrops(ox + Math.random() * cur.grid[0].length * tile, oy + Math.random() * cur.grid.length * tile,\n               VIEW.goo.G, 1, 0.8);\n}\n\nfunction slimeTargetAt(x, y) {\n  if (hudBtnOn(0) && hitBox(hudBtnBox(0), x, y)) return { kind: 'pause' };\n  if (hudBtnOn(1) && hitBox(hudBtnBox(1), x, y)) return { kind: 'mute' };\n  if (hudBtnOn(2) && hitBox(hudBtnBox(2), x, y)) return { kind: 'music' };\n  if (scene.cramped) return null;\n  if (MODE === 'title') {\n    if (hitBox(scene.titleBtn, x, y)) return { kind: 'start' };\n    if (hitBox(scene.dailyBtn, x, y)) return { kind: 'daily' };\n    if (hitBox(scene.shopBtn, x, y)) return { kind: 'shop' };\n  } else if (MODE === 'shop') {\n    if (hitBox(scene.shopBack, x, y)) return { kind: 'back' };\n    var rows = scene.shopRows || [];\n    for (var i = 0; i < rows.length; i++) if (hitBox(rows[i], x, y)) return { kind: 'row', row: rows[i] };\n  } else if (MODE === 'over') {\n    var b = SDK_AD.pending ? null : scene.overBtns;\n    if (b) {\n      if (hitBox(b.purge, x, y)) return { kind: 'revive' };\n      if (b.double && hitBox(b.double, x, y)) return { kind: 'double' };\n      if (hitBox(b.shop, x, y)) return { kind: 'shop' };\n      if (hitBox(b.again, x, y)) return { kind: 'again' };\n    }\n  } else if (MODE === 'pause') {\n    if (PAUSE.by !== 'ad' && scene.pauseBtns) {\n      if (hitBox(scene.pauseBtns.resume, x, y)) return { kind: 'resume' };\n      if (hitBox(scene.pauseBtns.restart, x, y)) return { kind: 'restart' };\n      if (hitBox(scene.pauseBtns.music, x, y)) return { kind: 'music' };\n      if (hitBox(scene.pauseBtns.sfx, x, y)) return { kind: 'sfx' };\n    }\n  }\n  if (MODE === 'run') {\n    var rk = toolRackBox();\n    if (rk) for (var ti = 0; ti < rk.ids.length; ti++) if (hitBox(toolBtnBox(ti), x, y)) return { kind: 'tool', id: rk.ids[ti] };\n  }\n  if (MODE !== 'run') return null;\n  if (coachOn() && scene.coachSkip && hitBox(scene.coachSkip, x, y)) return { kind: 'coachSkip' };\n  var t = slimeTileAt(x, y);\n  return t ? { kind: 'tile', tile: t } : null;\n}\n\nfunction slimeToggleMusic() { save.musicOn = !save.musicOn; audioSetLevels(); persist(); }\nfunction slimeToggleSfx() { save.sfxOn = !save.sfxOn; audioSetLevels(); persist(); }\n\nfunction slimeRestart() {\n  if (scene.lesson) { slimeLessonBegin(); return; }\n  slimeMidroll(slimeRestartNow);\n}\n\nfunction slimeRestartNow() {\n  if (MODE !== 'over' && MODE !== 'pause') return;\n  var daily = !!scene.daily;\n  sceneGo('run');\n  if (daily) { slimeStart(slimeDailySeed(new Date())); scene.daily = true; }\n  else slimeStart((Math.random() * 1e6) | 0, nextBoard);\n  nextBoard = null;\n  lastT = 0; coachStart(); slimeToolHint();\n}\n\nfunction slimeDailyKey() {\n  var d = new Date();\n  return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();\n}\n\nfunction slimeDailyStart() { slimePreroll(slimeDailyStartNow); }\n\nfunction slimeDailyStartNow() {\n  sceneGo('run');\n  slimeStart(slimeDailySeed(new Date()));\n  scene.daily = true;\n  nextBoard = null;\n  lastT = 0; coachStart(); slimeToolHint(); slimeHum(true, 1);\n  pumpKick = 1; sfxPumpsOn();\n}\n\nfunction slimeStartRun() { slimePreroll(slimeStartRunNow); }\n\nfunction slimeStartRunNow() {\n  if (MODE !== 'title') return;\n  sceneGo('run'); scene.run.t = 0; lastT = 0; coachStart(); slimeToolHint(); slimeHum(true, 1);\n  pumpKick = 1; sfxPumpsOn();\n}\n\nfunction slimeToolHint() {\n  if (save.hints.tool) return;\n  for (var i = 0; i < SHOP_TOOL_IDS.length; i++)\n    if (save.tools && save.tools[SHOP_TOOL_IDS[i]]) { slimeHint('tool', SHOP_TOOL_IDS[i]); return; }\n}\n\nfunction slimePoint(x, y, dir) {\n  ensureAudio();\n  musicStart();\n  var t = slimeTargetAt(x, y);\n  if (!t) return;\n  if (t.kind !== 'tile') pressKey(t.kind === 'row' ? 'row:' + t.row.id : t.kind);\n  if (t.kind !== 'tile' && t.kind !== 'back' && t.kind !== 'coachSkip') sfxUi();\n  if (scene.armTool && t.kind !== 'tool' && t.kind !== 'tile') scene.armTool = null;\n  switch (t.kind) {\n    case 'start':  slimeStartRun(); break;\n    case 'daily':  slimeDailyStart(); break;\n    case 'shop':   slimeShopOpen(); break;\n    case 'back':   sceneGo(shopFrom); sfxTurn(); break;\n    case 'row':    slimeShopBuy(t.row); break;\n    case 'revive': slimeRevive(); break;\n    case 'double': slimeDouble(); break;\n    case 'again':  slimeRestart(); break;\n    case 'mute':   slimeToggleSfx(); break;\n    case 'pause':  if (MODE === 'run') slimePause('user'); else if (PAUSE.by !== 'ad') slimeResume(); break;\n    case 'resume': slimeResume(); break;\n    case 'restart': slimeRestart(); break;\n    case 'music':  slimeToggleMusic(); break;\n    case 'sfx':    slimeToggleSfx(); break;\n    case 'coachSkip': coachSkip(); break;\n    case 'tool':   slimeToolPress(t.id); break;\n    case 'tile':   if (scene.armTool === 'repaint') slimeRepaintTap(t.tile.r, t.tile.c, dir); else slimeRotate(t.tile.r, t.tile.c, dir); break;\n  }\n}\n\nvar hover = null, hoverKind = '', cursorNow = '';\n\nfunction slimeHoverAt(x, y) {\n  hover = x < 0 ? null : { x: x, y: y };\n  var t = hover ? slimeTargetAt(x, y) : null;\n  hoverKind = t ? t.kind : '';\n  var want = t ? 'pointer' : 'default';\n  if (want !== cursorNow) { cursorNow = want; canvas.style.cursor = want; }\n}\n\nfunction hoverIn(b) { return !!(hover && hitBox(b, hover.x, hover.y)); }\n\nvar shopFrom = 'title';\n\nfunction slimeShopOpen() {\n  shopFrom = MODE;\n  sceneGo('shop');\n  sfxTurn();\n}\n\nfunction slimeShopBuy(r) {\n  var done = false, paid = false;\n  if (r.kind === 'skin') {\n    var st = shopSkinState(save, r.id);\n    if (st === 'buy' || st === 'owned') skinSnap();\n    if (st === 'buy') { done = shopBuySkin(save, r.id); paid = done; }\n    else if (st === 'owned') done = shopEquipSkin(save, r.id);\n    if (done) slimeSkinApply(save.skin);\n  } else if (r.kind === 'mod') {\n    done = shopBuyMod(save, r.id);\n    paid = done;\n  } else if (r.kind === 'tool') {\n    done = shopBuyTool(save, r.id);\n    paid = done;\n  } else {\n    done = shopBuyItem(save, r.id);\n    paid = done;\n  }\n  if (done) { persist(); sfxCash(); if (paid) walletSplash(VIEW.goo.G); } else sfxLocked();\n}\n\nfunction slimeKey(e) {\n  if (e.metaKey || e.ctrlKey || e.altKey) return;\n  var kk = e.key;\n  if (kk === ' ' || kk === 'Spacebar' || (typeof kk === 'string' && kk.indexOf('Arrow') === 0)) e.preventDefault();\n  if (e.repeat) return;\n  var k = e.key;\n  ensureAudio();\n  musicStart();\n  if (k === 'm' || k === 'M') { slimeToggleMusic(); e.preventDefault(); return; }\n  if (k === 'n' || k === 'N') { slimeToggleSfx(); e.preventDefault(); return; }\n  if (k === 'p' || k === 'P') {\n    if (MODE === 'run') { pressKey('pause'); slimePause('user'); }\n    else if (MODE === 'pause' && PAUSE.by !== 'ad' && !scene.cramped) { pressKey('resume'); slimeResume(); }\n    e.preventDefault(); return;\n  }\n  if (scene.cramped) return;\n  if (MODE === 'run' && (k === '1' || k === '2' || k === '3')) {\n    var tid = SHOP_TOOL_IDS[parseInt(k, 10) - 1];\n    if (scene.run.tools && scene.run.tools[tid].on) slimeToolPress(tid);\n    e.preventDefault(); return;\n  }\n  var enter = k === 'Enter' || k === ' ' || k === 'Spacebar';\n  var back = k === 'Backspace';\n  if (MODE === 'title') {\n    if (enter) { pressKey('start'); slimeStartRun(); }\n    else if (k === 's' || k === 'S') { pressKey('shop'); slimeShopOpen(); }\n    else if (k === 'd' || k === 'D') { pressKey('daily'); slimeDailyStart(); }\n    else return;\n  } else if (MODE === 'shop') {\n    if (enter || back) { pressKey('back'); sceneGo(shopFrom); sfxTurn(); }\n    else return;\n  } else if (MODE === 'over') {\n    if (!overCardUp()) return;\n    if (enter) { pressKey('again'); slimeRestart(); }\n    else if (k === 's' || k === 'S') { pressKey('shop'); slimeShopOpen(); }\n    else return;\n  } else if (MODE === 'pause') {\n    if (enter && PAUSE.by !== 'ad') { pressKey('resume'); slimeResume(); }\n    else return;\n  } else return;\n  e.preventDefault();\n}\n\nfunction hudBtnBox(i) {\n  var col = colBox();\n  var slot = (i === 1 && !hudBtnOn(0)) ? 0 : i;\n  return { x: col.x + col.w - 40 - slot * 46, y: 6, w: 40, h: 40 };\n}\n\nfunction hudBtnOn(i) {\n  var w = colBox().w;\n  if (i === 0) return MODE === 'run' || (MODE === 'pause' && PAUSE.by !== 'ad');\n  if (i === 1) return w >= 360 || !hudBtnOn(0);\n  return w >= 560;\n}\n\nfunction hudTagR() {\n  var r = 1e9, b, i;\n  for (i = 0; i < 3; i++) {\n    if (!hudBtnOn(i)) continue;\n    b = hudBtnBox(i);\n    if (b.x < r) r = b.x;\n  }\n  return (r === 1e9 ? colBox().x + colBox().w : r) - 8;\n}\n\nfunction drawHudButtons(now) {\n  if (hudBtnOn(0)) {\n    paintIconButton(hudBtnBox(0), 'pause', now, 'pause', true);\n    uiHud('пауза', hudBtnBox(0), 40);\n  }\n  if (hudBtnOn(1)) {\n    paintIconButton(hudBtnBox(1), save.sfxOn ? 'sfx' : 'sfxOff', now, 'sfx', true);\n    uiHud('звук', hudBtnBox(1), 40);\n  }\n  if (hudBtnOn(2)) {\n    paintIconButton(hudBtnBox(2), save.musicOn ? 'music' : 'musicOff', now, 'music', true);\n    uiHud('музыка', hudBtnBox(2), 40);\n  }\n}\n\nvar TOOL_BTN = 40, TOOL_STEP = 46, TOOL_LAMP = 14, TOOL_DOWN = 3;\n\nfunction toolOwned() {\n  var out = [], run = scene && scene.run;\n  if (!run || !run.tools) return out;\n  for (var i = 0; i < TOOL_IDS.length; i++) if (run.tools[TOOL_IDS[i]].on) out.push(TOOL_IDS[i]);\n  return out;\n}\n\nfunction toolRackBox() {\n  var ids = toolOwned();\n  if (!ids.length || scene.cramped) return null;\n  var b = sumpBox(), inner = sumpInnerBox(b);\n  var gb = goalsBoxFull(b), right = opBox().x - 10, step = TOOL_STEP;\n  var w = ids.length * step - (step - TOOL_BTN);\n  while (right - w < gb.x + gb.w && step > 42) {\n    step -= 1;\n    w = ids.length * step - (step - TOOL_BTN);\n  }\n  if (right - w < gb.x + gb.w) right = Math.min(opBox().x - 2, gb.x + gb.w + w);\n  return { x: right - w, y: inner.y + (inner.h - TOOL_BTN) / 2, w: w, h: TOOL_BTN, ids: ids, step: step };\n}\n\nfunction toolBtnBox(i) {\n  var rk = toolRackBox();\n  return rk ? { x: rk.x + i * rk.step, y: rk.y, w: TOOL_BTN, h: TOOL_BTN } : null;\n}\n\nfunction drawToolRack(now) {\n  var rk = toolRackBox();\n  if (!rk || (MODE !== 'run' && MODE !== 'pause')) return;\n  var run = scene.run, touch = slimeCoarsePointer();\n  if (!scene.toolFlash) scene.toolFlash = {};\n  if (!scene.toolWasReady) scene.toolWasReady = {};\n  for (var i = 0; i < rk.ids.length; i++) {\n    var id = rk.ids[i], b = toolBtnBox(i), ready = MODE === 'run' && slimeToolReady(run, id);\n    var left = slimeToolLeft(run, id), armed = scene.armTool === id;\n    if (ready && !scene.toolWasReady[id]) { scene.toolFlash[id] = now; if (run.t > 1) sfxUi(); }\n    scene.toolWasReady[id] = ready;\n    paintIconButton(b, 'tool' + id.charAt(0).toUpperCase() + id.slice(1), now, 'tool:' + id, true, left > 0 || armed, ready || armed ? 1 : 0.35);\n    var lit = ready || armed;\n    var lamp = uiFrame(lit ? 'toolLampOn' : 'toolLampOff') || uiFrame(lit ? 'lampOn' : 'lampOff');\n    if (lamp) {\n      ctx.save();\n      if (armed) ctx.globalAlpha = 0.55 + 0.45 * osc01(now, PULSE.swapWarn);\n      var fl = now - (scene.toolFlash[id] || -1e9);\n      if (fl >= 0 && fl < 300) { ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = 1 - fl / 300; }\n      ctx.drawImage(artImg('ui'), lamp.x, lamp.y, lamp.w, lamp.h, b.x + b.w - TOOL_LAMP + 2, b.y - 2, TOOL_LAMP, TOOL_LAMP);\n      ctx.restore();\n    }\n    if (left > 0) {\n      ctx.save();\n      ctx.font = '800 15px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';\n      ctx.fillStyle = VIEW.ink;\n      ctx.fillText(String(Math.ceil(left)), b.x + b.w / 2, b.y + b.h / 2 + 1);\n      ctx.restore();\n    }\n    if (!touch) tagText(TOOLS[id].key, b.x + b.w / 2, b.y + b.h + 9, VIEW.inkDim, 'center');\n    uiHud('пульт:' + id, b, 40);\n  }\n}\n\nfunction slimeToolPress(id) {\n  var run = scene.run;\n  if (MODE !== 'run' || run.over) return;\n  pressKey('tool:' + id);\n  if (id === 'repaint') {\n    if (scene.armTool === 'repaint') { scene.armTool = null; sfxUi(); return; }\n    if (!slimeToolReady(run, 'repaint')) { sfxLocked(); return; }\n    scene.armTool = 'repaint'; scene.repaintQuick = {}; sfxUi(); return;\n  }\n  if (scene.armTool === 'repaint') scene.armTool = null;\n  if (!slimeToolUse(run, id)) { sfxLocked(); return; }\n  if (id === 'hold') { scene.holdTick = -1; sfxHold(); }\n  else toolDrainFx();\n}\n\nfunction toolDrainFx() {\n  var b = sumpBox(), inner = sumpInnerBox(b);\n  var lvl = inner.y + inner.h * (1 - Math.max(0, Math.min(1, scene.contamShown != null ? scene.contamShown : scene.run.contam)));\n  var now = performance.now(), i;\n  scene.drainAt = now;\n  for (i = 0; i < 12; i++)\n    bubbles.push({ x: inner.x + (i + 0.5) * inner.w / 12, y: lvl + 6, r: 3 + Math.random() * 4, t0: now, life: 300 + Math.random() * 300 });\n  for (i = 0; i < 3; i++)\n    steam.push({ x: inner.x + inner.w * (0.25 + 0.25 * i), y: lvl - 6, r: tile * 0.09, t0: now, life: 900, vx: (Math.random() - 0.5) * 10, vy: -22, a0: 0.4 });\n  sfxDrain();\n}\n\nfunction repaintQuickFor(r, c) {\n  var key = r + ',' + c + '|' + (scene.run.gridVersion || 0), m = scene.repaintQuick || (scene.repaintQuick = {});\n  if (!(key in m)) m[key] = slimeRepaintQuick(cur.grid, r, c);\n  return m[key];\n}\n\nfunction slimeRepaintTap(r, c, dir) {\n  var t = cur.grid[r][c], now = performance.now();\n  if (t.type !== 'source') { scene.armTool = null; slimeRotate(r, c, dir); return; }\n  var plan = slimeRepaintPlan(cur.grid, scene.run, r, c);\n  if (!plan) { turnRefuse(r, c, dir, now); sfxLocked(); return; }\n  cur.flow = slimeRepaintApply(cur.grid, scene.run, plan);\n  slimeViaLast(cur.grid, scene.run);\n  scene.reachJob = null;\n  noteFlow(now);\n  var swx = ox + (c + 0.5) * tile, swy = oy + (r + 0.5) * tile;\n  spawnDrops(swx, swy, gooHex(plan.color), 22, 1.1);\n  spawnRing(swx, swy, gooHex(plan.color), tile * 0.5);\n  scene.splatAt = { r: r, c: c, at: now, hex: gooHex(plan.color) };\n  SHAKE = Math.max(SHAKE, 3);\n  scene.armTool = null;\n  sfxSwap();\n}\n\nvar lastMix = null;\nfunction slimeMusicState() {\n  var run = scene.run;\n  return { mode: MODE, over: !!run.over, contam: run.contam, rate: slimeRate(run),\n           shift: run.shift || slimeShift(run), mult: slimeMult(run) };\n}\nfunction slimeMusicFrame() {\n  if (!music) return;\n  var mix = musicMix(slimeMusicState());\n  if (lastMix && Math.abs(lastMix.pulse - mix.pulse) < 0.01 && Math.abs(lastMix.alarm - mix.alarm) < 0.01 &&\n      lastMix.arp === mix.arp && lastMix.cutoff === mix.cutoff && Math.abs(lastMix.bpm - mix.bpm) < 0.5) return;\n  musicApply(mix); lastMix = mix;\n}\n\nfunction slimeShiftBannerSub(shift, swapDone) {\n  var bSub = '';\n  if (shift === SLIME.leakFrom) bSub = 'Pipes are old. Expect leaks.';\n  if (shift === SLIME.rushFrom) bSub = bSub ? 'Leaks and rush orders. Good luck.' : 'Rush orders. Double pay, half the time.';\n  if (shift === SLIME.swapFrom && swapDone) bSub = 'Somebody swapped a pump. Not me.';\n  if (shift === SLIME.recipeFrom) bSub = 'Recipes. Three colours, one vat.';\n  if (shift > SLIME.recipeFrom && swapDone) bSub = shift % 2 ? 'Pump swap. Again.' : 'Another pump swap.';\n  return bSub;\n}\n\nfunction slimeFrame(now) {\n  var dt = lastT ? Math.min(0.05, (now - lastT) / 1000) : 0;\n  lastT = now;\n\n  UI_BOXES.length = 0;\n\n  if (scene.dry) slimeWake(now);\n\n  if (MODE === 'over' && !nextBoard && now - (scene.run.overShownAt || now) > 900) {\n    nextBoard = slimeBuildBoard((Math.random() * 1e6) | 0, slimeWantDims());\n    if (!nextBoard) nextBoard = slimeBuildBoard((Math.random() * 1e6) | 0);\n    lastT = 0;\n  }\n\n  stepGoo(MODE === 'run' && !scene.run.over ? dt : dt * 0.35);\n  stepShown(dt);\n  slimeMusicFrame();\n\n  if (MODE === 'run' && coachOn()) coachWatch();\n\n  if (MODE === 'run' && !scene.run.over) {\n    var ev = {};\n    if (scene.cramped && MODE === 'run') slimePause('hidden');\n    slimeStep(scene.run, cur.flow, dt, ev);\n    if (!scene.reachJob) scene.reachJob = slimeReachStart(cur.grid, scene.run, cur.flow);\n    if (!scene.reachJob.done) slimeReachTick(cur.grid, scene.run, scene.reachJob, 8);\n    slimeReachApply(scene.run, scene.reachJob);\n    var holdLeft = scene.run.holdUntil - scene.run.t;\n    if (holdLeft > 0 && holdLeft <= 2) {\n      var ht = Math.floor(holdLeft * 2);\n      if (ht !== scene.holdTick) { scene.holdTick = ht; sfxHoldTick(); }\n    }\n    slimeHum(true, slimeRate(scene.run), scene.run);\n\n    var gd = scene.lesson ? [] : goalsStep(scene.run, scene.goals);\n    for (var gi = 0; gi < gd.length; gi++) {\n      save.goo += GOAL_REWARD;\n      save.goalsDone++;\n      persist();\n      spawnPop(vw / 2, playBox().y + 40, 'GOAL  +' + GOAL_REWARD, VIEW.goo.G, true);\n      sfxCash();\n    }\n\n    if (ev.leakWanted) {\n      var lkc = slimeLeakPick(cur.grid, cur.flow, scene.run.rng);\n      if (lkc) {\n        cur.grid[lkc.r][lkc.c].leak = 1;\n        scene.run.leakOpen = lkc;\n      }\n    }\n    if (ev.swapWarn) {\n      scene.run.swapPlan = slimePlanSwap(cur.grid, scene.run);\n      if (scene.run.swapPlan) sfxSwapWarn();\n    }\n    if (ev.swap) {\n      var sw = ev.swap;\n      cur.flow = slimeApplySwap(cur.grid, scene.run, sw);\n      slimeViaLast(cur.grid, scene.run);\n      scene.reachJob = null;\n      noteFlow(now);\n      if (!sw.skipped) {\n        var swx = ox + (sw.c + 0.5) * tile, swy = oy + (sw.r + 0.5) * tile;\n        spawnDrops(swx, swy, gooHex(sw.color), 22, 1.1);\n        spawnRing(swx, swy, gooHex(sw.color), tile * 0.5);\n        SHAKE = Math.max(SHAKE, 3);\n        sfxSwap();\n      }\n    }\n    if (ev.shift) {\n      var swapDone = !!(ev.swap && !ev.swap.skipped);\n      scene.banner = { at: now, text: 'SHIFT ' + ev.shift, sub: slimeShiftBannerSub(ev.shift, swapDone) };\n      sfxShift();\n    }\n    for (var oi = 0; oi < scene.run.orders.length; oi++) {\n      var ord = scene.run.orders[oi];\n      if (ord.rush && !ord.rushSeen) { ord.rushSeen = true; sfxRush(); }\n      if (!ord.rush) ord.rushSeen = false;\n    }\n\n    if (ev.delivered) ev.delivered.forEach(function (d) {\n      var o = scene.run.orders[d.i];\n      o.shakeAt = now;\n      o.flashAt = now;\n      scene.wavePulse = { at: now, r: o.r, c: o.c };\n      var cx = ox + (o.c + 0.5) * tile, cy = oy + (o.r + 0.5) * tile;\n      spawnDrops(cx, cy, gooHex(d.got), 18, 1);\n      spawnRing(cx, cy, gooHex(d.got), tile * 0.42);\n      var m = slimeMult(scene.run);\n      spawnPop(cx, cy, scene.lesson ? 'DELIVERED' : '+' + (o.lastPts || Math.round(SLIME.basePoints * m)), gooHex(d.got), m >= 3, popScale());\n      SHAKE = Math.max(SHAKE, 1.4);\n      coachSignal('delivered', d.i);\n      slimeHint('deliver');\n      sfxDeliver(scene.run.combo);\n      if (scene.run.combo >= 3) {\n        var chipAt = { x: colBox().x + 60, y: hudNumY() - 8 };\n        for (var sp2 = 0; sp2 < 4; sp2++)\n          uiDrops.push({ x: chipAt.x + Math.random() * 20, y: chipAt.y, hex: VIEW.goo.Y,\n                         vx: (Math.random() - 0.5) 