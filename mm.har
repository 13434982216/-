   tabW: 0.46,\n    tabH: 0.15,\n    tabGap: 0.34,\n    plinthW: 0.42,\n    plinthH: 0.15,\n    plinthGap: 0.32,\n\n    filterW: 0.46,\n    filterH: 0.34,\n    filterRad: 0.05,\n    filterRibW: 0.035,\n    filterRibGap: 0.15,\n\n    outMuffaW: 0.30,\n    outMuffaH: 0.07,\n    outMuffaGap: 0.05,\n\n    endFlangeW: 0.26,\n    endFlangeT: 0.06,\n    endFlangeRad: 2,\n\n    bridgeShadowBlur: 0.13,\n    bridgeShadowAlpha: 0.6,\n    bridgeShadowDy: 0.035,\n    hubR: 0.16,\n\n    srcPulseAmp: 0.02,\n    srcPulseMs: 1200,\n\n    winPlateDelay: 700,\n    starPopMs: 120,\n    starCascadeMs: 60,\n    winPlateShadow: 22,\n    winPlateShadowAlpha: 0.45,\n    winPlateShadowDy: 4,\n    winPlateRad: 16,\n    winPlateTopLight: 0.10,\n    winPlateBotDark: 0.06,\n    winPlateBevel: 0.05,\n    winPlateBevelH: 10,\n    winPlateEdgeAlpha: 0.45,\n    winPlateInMs: 220,\n    winPlateFromScale: 0.90,\n    winPlateOvershoot: 0.03,\n    winPlateRise: 10,\n    winGlowAlpha: 0.30,\n    winGlowRel: 2.2,\n    winDivAlpha: 0.10,\n    winNewBestAlpha: 0.95,\n    winBestAlpha: 0.70,\n    pauseScrim: 'rgba(15,18,23,0.66)',\n    winCapPulseMs: 1400,\n    winCapAlphaLo: 0.45,\n    winCapAlphaHi: 0.70,\n  },\n\n  juice: {\n    waveMs: 60,\n    waveRamp: 0.6,\n    glintW: 0.45,\n    glintAlpha: 0.85,\n\n    particles: 30,\n    pLifeMs: 1000,\n    pGrav: 1500,\n    pUp: 260,\n\n    errPulseMs: 220,\n    errThick: 1.4\n  }\n};\n\nCFG.hudTop = CFG.ui.btnTop + CFG.ui.btn;\n\nvar TRAILER = false;\nvar TRAILER_MARGIN = 0.06;\n\nvar DEV_STAND = false;\n\nvar SHOW_BUILD_ID = false;\n\nconst DIFFICULTY = [\n  { доУровня: 5,   difficulty: { size: [5,5], sources: [2,2], outputs: [1,1], mixes: [1,1], fill: 0.55, loops: [0,0], moves: { frac: 0.45, min: 2, max: 3 } } },\n\n  { доУровня: 11,  difficulty: { size: [5,5], sources: [2,2], outputs: [2,2], mixes: [1,1], fill: 0.65, loops: [0,0], moves: { frac: 0.55, min: 4, max: 15 } } },\n\n  { доУровня: 15,  difficulty: { size: [5,5], sources: [2,2], outputs: [2,2], mixes: