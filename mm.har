  var st = coachStep();\n  if (!st || !scene.lesson) return null;\n  var holes = [], pipe = coachPipe(), o = st.vat != null ? slimeLessonOrder(scene.run, st.vat) : null;\n  if (pipe) holes.push({ x: ox + (pipe.c + 0.5) * tile, y: oy + (pipe.r + 0.5) * tile, r: tile * 0.78, pipe: pipe });\n  if (o && !o.lessonDone) holes.push({ x: ox + (o.c + 0.5) * tile, y: oy + (o.r + 0.5) * tile, r: tile * 0.9, vat: o });\n  var col = colBox();\n  var gauge = st.dirt ? { x: col.x - 8, y: hudBarY() - 8, w: col.w + 16, h: barH() + 16 } : null;\n  return { holes: holes, gauge: gauge };\n}\n\nfunction paintTapMark(x, y, R, now) {\n  var ph = (now / 900) % 1;\n  var himg = artImg('bust'), hf = himg && ART_MANIFEST.bust.frames.hand;\n  if (hf) {\n    ctx.save();\n    var press = ph < 0.18 ? ph / 0.18 : (ph < 0.36 ? 1 - (ph - 0.18) / 0.18 : 0);\n    var hs = R * 1.7 / hf.h, lift = R * 0.3 * (1 - press);\n    ctx.globalAlpha = 1;\n    ctx.imageSmoothingQuality = 'high';\n    ctx.drawImage(himg, hf.x, hf.y, hf.w, hf.h, x + lift - hf.tipX * hs, y + lift - hf.tipY * hs, hf.w * hs, hf.h * hs);\n    ctx.restore();\n    return;\n  }\n  ctx.save();\n  ctx.translate(x, y);\n\n  ctx.globalAlpha = 0.55 * (1 - ph);\n  ctx.strokeStyle = VIEW.ink;\n  ctx.lineWidth = 3;\n  ctx.beginPath(); ctx.arc(0, 0, R * (0.45 + 0.75 * ph), 0, Math.PI * 2); ctx.stroke();\n\n  ctx.globalAlpha = 0.9;\n  ctx.fillStyle = VIEW.ink;\n  ctx.beginPath(); ctx.arc(0, 0, R * 0.13, 0, Math.PI * 2); ctx.fill();\n\n  var a0 = -Math.PI * 0.85, a1 = a0 + Math.PI * 1.15 * (0.35 + 0.65 * Math.min(1, ph * 1.6));\n  ctx.globalAlpha = 0.95;\n  ctx.strokeStyle = VIEW.goo.G;\n  ctx.lineWidth = 4;\n  ctx.lineCap = 'round';\n  ctx.beginPath(); ctx.arc(0, 0, R * 0.68, a0, a1); ctx.stroke();\n  var hx = Math.cos(a1) * R * 0.68, hy = Math.sin(a1) * R * 0.68;\n  ctx.translate(hx, hy);\n  ctx.rotate(a1 + Math.PI / 2);\n  ctx.fillStyle = VIEW.goo.G;\n  ctx.beginPath();\n  ctx.moveTo(0, -R * 0.17); ctx.lineTo(R * 0.13, R * 0.07); ctx.lineTo(-R * 0.13, R * 0.07);\n  ctx.closePath(); ctx.fill();\n  ctx.restore();\n}\n\nvar LESSON_CARD_H = 160, LESSON_GAP = 14, LESSON_BUST_SIDE = 120, LESSON_BUST_TOP = 104, LESSON_BUST_OVER = 0.62;\n\nfunction lessonGeom() {\n  var box = playBox(), bw = cur.grid[0].length * tile, bh = cur.grid.length * tile, h = LESSON_CARD_H;\n  var art = !!artImg('bust'), side = Math.floor((box.w - bw) / 2) - 20, g = { card: null, bust: 0, ox: ox, oy: oy };\n  if (side >= 200) {\n    var sw = Math.min(side, 380), P = art ? LESSON_BUST_SIDE : 0;\n    if (P && box.h < h + Math.round(P * LESSON_BUST_OVER) + 20) P = 0;\n    var over = Math.round(P * LESSON_BUST_OVER);\n    g.card = { x: box.x + 10, y: Math.round(box.y + (box.h - h - over) / 2 + over), w: sw, h: h };\n    g.bust = P;\n    var right = g.card.x + sw;\n    g.ox = Math.round(right + (box.x + box.w - right - bw) / 2);\n    return g;\n  }\n  var pw = Math.min(box.w - 28, 520), px = Math.round(vw / 2 - pw / 2), P2 = art ? LESSON_BUST_TOP : 0;\n  if (Math.round(P2 * LESSON_BUST_OVER) + h + LESSON_GAP + bh > box.h) P2 = 0;\n  var over2 = Math.round(P2 * LESSON_BUST_OVER);\n  if (h + LESSON_GAP + bh <= box.h) {\n    var top = Math.round(box.y + (box.h - over2 - h - LESSON_GAP - bh) / 2) + over2;\n    g.card = { x: px, y: top, w: pw, h: h };\n    g.bust = P2;\n    g.oy = top + h + LESSON_GAP;\n    return g;\n  }\n  g.card = { x: px, y: vh - SAFE.bottom - h - 10, w: pw, h: h };\n  return g;\n}\n\nfunction lessonVatNeed(o) {\n  for (var i = 0; i < SLIME_LESSON.vats.length; i++)\n    if (SLIME_LESSON.vats[i].r === o.r && SLIME_LESSON.vats[i].c === o.c) return SLIME_LESSON.vats[i].need;\n  return null;\n}\n\nfunction lessonCheer() {\n  for (var i = 0; i < SLIME_LESSON.vats.length; i++) {\n    var v = SLIME_LESSON.vats[i], x = ox + (v.c + 0.5) * tile, y = oy + (v.r + 0.5) * tile;\n    spawnDrops(x, y, gooHex(v.need), 16, 1.1);\n    spawnRing(x, y, gooHex(v.need), tile * 0.5);\n  }\n  sfxRecipe();\n}\n\nfunction paintLessonBust(cb, P, pose) {\n  v