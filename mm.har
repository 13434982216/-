            "text": "var NET_STEPS = [[-1, 0], [1, 0], [0, -1], [0, 1]];\n\nvar NET_MAX_DEG = 3;\n\nfunction netDims(rng, size) {\n  if (size && !Array.isArray(size) && typeof size === 'object')\n    return { r: netPick(rng, size.r), c: netPick(rng, size.c) };\n  var n = netPick(rng, size);\n  return { r: n, c: n };\n}\n\nfunction netDm(x) { return (x && typeof x === 'object' && !Array.isArray(x)) ? x : { r: x, c: x }; }\n\nfunction netInBounds(dm, r, c) {\n  var R = typeof dm === 'number' ? dm : dm.r, C = typeof dm === 'number' ? dm : dm.c;\n  return r >= 0 && r < R && c >= 0 && c < C;\n}\n\nfunction netPick(rng, range) {\n  return Array.isArray(range) ? range[0] + Math.floor(rng() * (range[1] - range[0] + 1)) : range;\n}\n\nfunction netShuffle(rng, arr) {\n  for (var i = arr.length - 1; i > 0; i--) {\n    var j = Math.floor(rng() * (i + 1));\n    var t = arr[i]; arr[i] = arr[j]; arr[j] = t;\n  }\n  return arr;\n}\n\nfunction netTerminals(rng, dm, count) {\n  dm = netDm(dm);\n  var cells = [];\n  for (var r = 0; r < dm.r; r++) for (var c = 0; c < dm.c; c++) cells.push([r, c]);\n  netShuffle(rng, cells);\n  var out = [];\n  for (var k = 0; k < cells.length && out.length < count; k++) {\n    var ok = true;\n    for (var m = 0; m < out.length; m++) {\n      var d = Math.max(Math.abs(out[m][0] - cells[k][0]), Math.abs(out[m][1] - cells[k][1]));\n      if (d < 2) { ok = false; break; }\n    }\n    if (ok) out.push(cells[k]);\n  }\n  return out.length === count ? out : null;\n}\n\nfunction netWalk(rng, dm, start, minLen, inNet, isTerm, deg, maxDeg) {\n  dm = netDm(dm);\n  maxDeg = maxDeg || NET_MAX_DEG;\n  var path = [start], idx = {};\n  idx[start[0] * dm.c + start[1]] = 0;\n  for (var guard = 0; guard < dm.r * dm.c * 40; guard++) {\n    var cur = path[path.length - 1];\n    var free = [], finish = [];\n    for (var d = 0; d < 4; d++) {\n      var nr = cur[0] + NET_STEPS[d][0], nc = cur[1] + NET_STEPS[d][1];\n      if (!netInBounds(dm, nr, nc)) continue;\n      var isStart = nr === start[0] && nc === start[1];\n      if (inNet[nr][nc]) {\n        if (deg[nr][nc] >= maxDeg) continue;\n        if (isTerm[nr][nc] && deg[nr][nc] >= 1) continue;\n        finish.push([nr, nc]);\n      } else if (!isTerm[nr][nc] || isStart) {\n        free.push([nr, nc]);\n      }\n    }\n    var nxt;\n    if (path.length < minLen && free.length) nxt = free[Math.floor(rng() * free.length)];\n    else if (finish.length) { path.push(finish[Math.floor(rng() * finish.length)]); return path; }\n    else if (free.length) nxt = free[Math.floor(rng() * free.length)];\n    else return null;\n\n    var k = nxt[0] * dm.c + nxt[1];\n    if (k in idx) {\n      for (var z = path.length - 1; z > idx[k]; z--) delete idx[path[z][0] * dm.c + path[z][1]];\n      path.length = idx[k] + 1;\n    } else {\n      idx[k] = path.length;\n      path.push(nxt);\n    }\n  }\n  return null;\n}\n\nfunction netTree(rng, dm, terminals, fill, loops, maxDeg) {\n  dm = netDm(dm);\n  maxDeg = maxDeg || NET_MAX_DEG;\n  var deg = [], inNet = [], isTerm = [];\n  for (var r = 0; r < dm.r; r++) {\n    deg.push([]); inNet.push([]); isTerm.push([]);\n    for (var c = 0; c < dm.c; c++) { deg[r].push(0); inNet[r].push(false); isTerm[r].push(false); }\n  }\n  for (var i = 0; i < terminals.length; i++) isTerm[terminals[i][0]][terminals[i][1]] = true;\n\n  var edges = [];\n  function addEdge(a, b) {\n    edges.push([a[0], a[1], b[0], b[1]]);\n    deg[a[0]][a[1]]++; deg[b[0]][b[1]]++;\n  }\n\n  inNet[terminals[0][0]][terminals[0][1]] = true;\n  var cells = 1;\n  var target = Math.round(fill * dm.r * dm.c);\n\n  for (var t = 1; t < terminals.length; t++) {\n    var need = Math.max(2, Math.round((target - cells) / (terminals.length - t)));\n    var path = netWalk(rng, dm, terminals[t], need, inNet, isTerm, deg, maxDeg);\n    if (!path) return null;\n    for (var p = 0; p + 1 < path.length; p++) addEdge(path[p], path[p + 1]);\n    for (var q = 0; q < path.length; q++)\n      if (!inNet[path[q][0]][path[q][1]]) { inNet[path[q][0]][path[q][1]] = true; cells++; }\n  }\n  if (cells < target) return null;\n\n  var added = 0;\n  for (var tries = 0; added < loops && tries < dm.r * dm.c * 30; tries++) {\n    var r0 = Math.floor(rng() * dm.r), c0 = Math.floor(rng() * dm.c);\n    var st = NET_STEPS[Math.floor(rng() * 4)];\n    var r1 = r0 + st[0], c1 = c0 + st[1];\n    if (!netInBounds(dm, r1, c1)) continue;\n    if (!inNet[r0][c0] || !inNet[r1][c1]) continue;\n    if (isTerm[r0][c0] || isTerm[r1][c1]) continue;\n    if (deg[r0][c0] >= maxDeg || deg[r1][c1] >= maxDeg) continue;\n    var dup = false;\n    for (var e = 0; e < edges.length && !dup; e++) {\n      var E = edges[e];\n      if ((E[0] === r0 && E[1] === c0 && E[2] === r1 && E[3] === c1) ||\n          (E[0] === r1 && E[1] === c1 && E[2] === r0 && E[3] === c0)) dup = true;\n    }\n    if (dup) continue;\n    addEdge([r0, c0], [r1, c1]);\n    added++;\n  }\n  if (added < loops) return null;\n\n  return { edges: edges, deg: deg, cells: cells };\n}\n\nfunction rotFor(base, dirs) {\n  var d = dirs.slice().sort(function (a, b) { return a - b; });\n  for (var r = 0; r < 4; r++) {\n    var got = base.map(function (x) { return (x + r) % 4; }).sort(function (a, b) { return a - b; });\n    if (got.length === d.length) {\n      var ok = true;\n      for (var i = 0; i < got.length; i++) if (got[i] !== d[i]) { ok = false; break; }\n      if (ok) return r;\n    }\n  }\n  return 0;\n}\n\nfunction netEdgeDirs(dm, edges) {\n  dm = netDm(dm);\n  var dirs = [];\n  for (var r = 0; r < dm.r; r++) { dirs.push([]); for (var c = 0; c < dm.c; c++) dirs[r].push([]); }\n  for (var i = 0; i < edges.length; i++) {\n    var e = edges[i], dr = e[2] - e[0], dc = e[3] - e[1];\n    var d = dr === -1 ? 0 : (dc === 1 ? 1 : (dr === 1 ? 2 : 3));\n    dirs[e[0]][e[1]].push(d);\n    dirs[e[2]][e[3]].push((d + 2) % 4);\n  }\n  return dirs;\n}\n\nfunction netTiles(dm, edges, terminals, assign) {\n  dm = netDm(dm);\n  var dirs = netEdgeDirs(dm, edges), grid = [];\n  for (var r = 0; r < dm.r; r++) {\n    grid.push([]);\n    for (var c = 0; c < dm.c; c++) grid[r].push({ type: 'empty', rot: 0, fixed: true });\n  }\n  for (var ti = 0; ti < terminals.length; ti++) {\n    var tr = terminals[ti][0], tc = terminals[ti][1];\n    if (dirs[tr][tc].length !== 1) return null;\n    var isSrc = assign.roles[ti] === 'src';\n    var tile = { type: isSrc ? 'source' : 'output', rot: 0, fixed: true };\n    tile.rot = rotFor(CFG.baseConnectors[tile.type], dirs[tr][tc]);\n    if (isSrc) tile.color = assign.colors[ti]; else tile.need = assign.needs[ti];\n    grid[tr][tc] = tile;\n  }\n  for (var r2 = 0; r2 < dm.r; r2++) for (var c2 = 0; c2 < dm.c; c2++) {\n    if (grid[r2][c2].type !== 'empty') continue;\n    var ds = dirs[r2][c2];\n    if (!ds.length) continue;\n    if (ds.length < 2) return null;\n    var type = ds.length === 4 ? 'cross' : (ds.length === 3 ? 'tee' : (((ds[0] + 2) % 4 === ds[1]) ? 'straight' : 'elbow'));\n    grid[r2][c2] = { type: type, rot: rotFor(CFG.baseConnectors[type], ds), fixed: type === 'cross' };\n  }\n  var fl = assign.filters || [];\n  for (var fi2 = 0; fi2 < fl.length; fi2++) {\n    var fc2 = grid[fl[fi2].r][fl[fi2].c];\n    if (!fc2 || fc2.type !== 'straight') return null;\n    fc2.type = 'filter';\n    fc2.sub = fl[fi2].sub;\n  }\n  return grid;\n}\n\nvar NET_PRIMARY = ['R', 'Y', 'B'];\n\nvar NET_FILTER_TRIES = 3;\n\nfunction netOutNeeds(grid, terminals, roles) {\n  var flow = computeFlow(grid), out = [];\n  for (var i = 0; i < terminals.length; i++)\n    out.push(roles[i] === 'src' ? null : flow[terminals[i][0]][terminals[i][1]][0]);\n  return { needs: out, flow: flow };\n}\n\nfunction netFilterCands(grid, flow, dm) {\n  dm = netDm(dm);\n  var cand = [], r, c, i;\n  for (r = 0; r < dm.r; r++) for (c = 0; c < dm.c; c++) {\n    if (grid[r][c].type !== 'straight') continue;\n    var col = flow[r][c][0];\n    if (col == null) continue;\n    var m = colorMask(col);\n    for (i = 0; i < NET_PRIMARY.length; i++) {\n      var sm = colorMask(NET_PRIMARY[i]);\n      if ((m & sm) && (m & ~sm)) cand.push({ r: r, c: c, sub: NET_PRIMARY[i] });\n    }\n  }\n  return cand;\n}\n\nfunction netDrawFilters(rng, cand, dm, want) {\n  dm = netDm(dm);\n  netShuffle(rng, cand);\n  var out = [], used = {}, i;\n  for (i = 0; i < cand.length && out.length < want; i++) {\n    var k = cand[i].r * dm.c + cand[i].c;\n    if (used[k]) continue;\n    used[k] = 1;\n    out.push(cand[i]);\n  }\n  return out;\n}\n\nfunction netColors(rng, dm, edges, terminals, nSources, wantMix, wantDrain, wantFilter) {\n  dm = netDm(dm);\n  var n = terminals.length;\n  wantDrain = wantDrain || 0;\n  wantFilter = wantFilter || 0;\n  if (nSources < 1 || nSources >= n) return null;\n  for (var attempt = 0; attempt < 120; attempt++) {\n    var order = [];\n    for (var i = 0; i < n; i++) order.push(i);\n    netShuffle(rng, order);\n    var roles = [], colors = [], needs = [];\n    for (var i2 = 0; i2 < n; i2++) { roles.push('out'); colors.push(null); needs.push(undefined); }\n    for (var s = 0; s < nSources; s++) {\n      roles[order[s]] = 'src';\n      colors[order[s]] = NET_PRIMARY[Math.floor(rng() * 3)];\n    }\n    var trial = { roles: roles, colors: colors, needs: needs, filters: [] };\n    var probe = netTiles(dm, edges, terminals, trial);\n    if (!probe) return null;\n    var flow = computeFlow(probe);\n\n    if (wantFilter > 0) {\n      var bare = [], anyDry = false, bi;\n      for (bi = 0; bi < n; bi++) {\n        if (roles[bi] === 'src') { bare.push(null); continue; }\n        var bc = flow[terminals[bi][0]][terminals[bi][1]][0];\n        if (bc == null) anyDry = true;\n        bare.push(bc);\n      }\n      if (anyDry) continue;\n      var cand = netFilterCands(probe, flow, dm);\n      var placed = null;\n      if (!cand.length) continue;\n      for (var ft = 0; ft < NET_FILTER_TRIES && !placed; ft++) {\n        var pick = netDrawFilters(rng, cand, dm, wantFilter), pi;\n        if (!pick.length) break;\n        for (pi = 0; pi < pick.length; pi++) {\n          probe[pick[pi].r][pick[pi].c].type = 'filter';\n          probe[pick[pi].r][pick[pi].c].sub = pick[pi].sub;\n        }\n        var res = netOutNeeds(probe, terminals, roles);\n        var dry = false, changed = false;\n        for (var ci = 0; ci < n; ci++) {\n          if (roles[ci] === 'src') continue;\n          if (res.needs[ci] == null) dry = true;\n          if (bare[ci] !== res.needs[ci]) changed = true;\n        }\n        if (!dry && changed) { placed = pick; flow = res.flow; break; }\n        for (pi = 0; pi < pick.length; pi++) {\n          probe[pick[pi].r][pick[pi].c].type = 'straight';\n          probe[pick[pi].r][pick[pi].c].sub = undefined;\n        }\n      }\n      if (placed) trial.filters = placed;\n    }\n\n    var ok = true, sec = 0, drains = 0;\n\n    if (wantDrain === 0)\n      for (var rz = 0; rz < dm.r && ok; rz++)\n        for (var cz = 0; cz < dm.c; cz++)\n          for (var gz = 0; gz < flow[rz][cz].length; gz++)\n            if (flow[rz][cz][gz] === 'SLAG') { ok = false; break; }\n    if (!ok) continue;\n    for (var i3 = 0; i3 < n && ok; i3++) {\n      if (roles[i3] === 'src') continue;\n      var col = flow[terminals[i3][0]][terminals[i3][1]][0];\n      if (col == null) { ok = false; break; }\n      needs[i3] = col;\n      if (col === 'SLAG') drains++;\n      else if (CFG.secondaryColors.indexOf(col) !== -1) sec++;\n    }\n    if (!ok || sec !== wantMix || drains !== wantDrain) continue;\n    return trial;\n  }\n  return null;\n}\n\nfunction buildNetLevel(rng, diff) {\n  for (var attempt = 0; attempt < 40; attempt++) {\n    var dm = netDims(rng, diff.size);\n    var nSrc = netPick(rng, diff.sources);\n    var nOut = netPick(rng, diff.outputs);\n    var wantDrain = Math.min(diff.drains ? netPick(rng, diff.drains) : 0, Math.max(0, nOut - 1));\n    var wantMix = Math.min(netPick(rng, diff.mixes), nOut - wantDrain);\n    var wantFilter = diff.filters ? netPick(rng, diff.filters) : 0;\n    var terminals = netTerminals(rng, dm, nSrc + nOut);\n    if (!terminals) continue;\n    var net = netTree(rng, dm, terminals, diff.fill, netPick(rng, diff.loops), diff.maxDeg);\n    if (!net) continue;\n    var assign = netColors(rng, dm, net.edges, terminals, nSrc, wantMix, wantDrain, wantFilter);\n    if (!assign) continue;\n    var solution = netTiles(dm, net.edges, terminals, assign);\n    if (!solution || !levelSolved(solution)) continue;\n    return {\n      size: dm.r,\n      rows: dm.r,\n      cols: dm.c,\n      grid: solution,\n      par: Math.max(1, targetMoves(solution, diff.moves)),\n      _solution: solution,\n      attempts: attempt + 1\n    };\n  }\n  return null;\n}\n"
