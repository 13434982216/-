            "size": 6616,
            "mimeType": "application/javascript",
            "text": "const CFG = {\n  palette: {\n    bg:        '#171b21',\n    grid:      '#212730',\n    emptyPipe: '#8fa0ac',\n    glass:     'rgba(255,255,255,0.30)',\n    glintFull: 'rgba(255,255,255,0.60)',\n    glintEmpty:'rgba(255,255,255,0.28)',\n    R: '#e04b3a',\n    Y: '#e8b93c',\n    B: '#3f7ec2',\n    O: '#e07b28',\n    G: '#4f9c46',\n    P: '#8455a8',\n    slag:      '#8f8570',\n    text:      '#efe6d8',\n    win:       '#d9b44a',\n\n    textDim:   '#9aa7b4',\n\n    winDim:    '#8b773a',\n\n    chrome:    '#39424f',\n    err:       '#c0392b',\n\n    errHalo:   '#ffb4a0'\n  },\n\n  dirs: { UP: 0, RIGHT: 1, DOWN: 2, LEFT: 3 },\n  dx: [0, 1, 0, -1],\n  dy: [-1, 0, 1, 0],\n\n  baseConnectors: {\n    straight: [0, 2],\n    elbow:    [0, 1],\n    tee:      [0, 1, 2],\n    cross:    [0, 1, 2, 3],\n    filter:   [0, 2],\n    source:   [2],\n    output:   [0],\n    empty:    []\n  },\n\n  connectorGroups: {\n    straight: [[0, 2]],\n    elbow:    [[0, 1]],\n    tee:      [[0, 1, 2]],\n    cross:    [[0, 2], [1, 3]],\n    filter:   [[0, 2]],\n    source:   [[2]],\n    output:   [[0]],\n    empty:    []\n  },\n\n  mixPairs: { 'R+Y': 'O', 'B+Y': 'G', 'B+R': 'P' },\n  secondaryColors: ['O', 'G', 'P'],\n\n  pigment:     { R: 1, Y: 2, B: 4 },\n  colorByMask: { 1: 'R', 2: 'Y', 4: 'B', 3: 'O', 6: 'G', 5: 'P', 7: 'SLAG' },\n\n  tileCorner: 0.18,\n\n  outlineFactor: 0.36,\n  bodyFactor: 0.22,\n  hlFactor: 0.05,\n  hlOffset: 0.04,\n  outlineDarken: 0.25,\n\n  sourceRadius: 0.28,\n  needRing: 0.10,\n  circleOutline: 0.06,\n\n  flangeWidth: 0.42,\n  flangeLen: 0.08,\n  flangeRad: 2,\n  rotMs: 120,\n  fillMs: 200,\n  fillRamp: 0.4,\n  errStroke: 3,\n  winStroke: 6,\n  hudFont: '600 18px system-ui, sans-serif',\n  winFont: '600 22px system-ui, sans-serif',\n\n  ui: {\n    oneDayMs: 86400000,\n    btn: 44,\n    btnGap: 8,\n    btnTop: 8,\n    pad: 10,\n    btnFont: '600 13px system-ui, sans-serif',\n    numFont: '700 15px system-ui, sans-serif',\n\n    winStarR: 17,\n    win