            "text": "var SLIME_DIFF = {\n  size: { r: 7, c: 7 }, sources: [4, 5], outputs: [3, 4], mixes: [2, 2],\n  fill: 0.78, loops: [3, 6], moves: { frac: 0.85, min: 12, max: 46 },\n  maxDeg: 4, drains: [0, 0], filters: [0, 1]\n};\n\nvar SLIME_BOARD = {\n  minCells: 36, maxCells: 70,\n  tileMin: 42, tileMax: 170,\n  tileGood: 64,\n  goodFill: 0.90,\n  cols: [5, 14], rows: [4, 12]\n};\n\nfunction slimeClamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }\n\nfunction best_fill(b) { return b ? b.fill : -1; }\nfunction best_cells(b) { return b ? b.cells : -1; }\n\nfunction slimeFitDims(boxW, boxH) {\n  var B = SLIME_BOARD, best = null, r, c;\n  for (var pass = 0; pass < 4 && !best; pass++) {\n    var lo = pass > 2 ? 8 : (pass === 0 ? B.tileGood : B.tileMin), hi = pass > 2 ? 1e9 : B.tileMax;\n    var need = pass > 1 ? 0 : B.goodFill;\n    for (r = B.rows[0]; r <= B.rows[1]; r++)\n      for (c = B.cols[0]; c <= B.cols[1]; c++) {\n        var cells = r * c;\n        if (cells > B.maxCells || cells < B.minCells) continue;\n        var t = Math.floor(Math.min(boxW / c, boxH / r));\n        if (t < lo || t > hi) continue;\n        var fill = Math.min(t * c / boxW, t * r / boxH);\n        if (fill < need) continue;\n        var better = pass > 1 ? (fill > best_fill(best)) : (cells > best_cells(best) ||\n                     (cells === best_cells(best) && fill > best_fill(best)));\n        if (!best || better) best = { r: r, c: c, fill: fill, cells: cells };\n      }\n  }\n  if (!best) {\n    var tiny = null;\n    for (r = B.rows[0]; r <= B.rows[1]; r++)\n      for (c = B.cols[0]; c <= B.cols[1]; c++) {\n        var cells2 = r * c;\n        if (cells2 > B.maxCells || cells2 < B.minCells) continue;\n        var t2 = Math.min(boxW / c, boxH / r);\n        if (!tiny || cells2 < tiny.cells || (cells2 === tiny.cells && t2 > tiny.t)) tiny = { r: r, c: c, cells: cells2, t: t2 };\n      }\n    if (tiny) return { r: tiny.r, c: tiny.c, tile: Math.max(1, Math.floor(tiny.t)), ok