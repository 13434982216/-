) return 'Not bad. The pipes disagree.';\n  return 'You outlasted the night crew.';\n}\n\nfunction drawOverCard(now, runArg) {\n  var run = runArg || scene.run;\n  var age = now - (run.overShownAt == null ? now : run.overShownAt);\n  if (age < 0) { if (!runArg) scene.overBtns = null; return; }\n  var W = Math.min(320, vw - CARD_EDGE * 2), cx = W / 2;\n  var noDouble = !SLIME_ADS.ready, H = noDouble ? 368 : 424;\n\n  var b = cardOpen(W, H);\n  var base = ctx.globalAlpha;\n  paintCard(b);\n  paintCardTop(b, run.over ? 'LINE RUPTURE' : 'SHIFT REPORT', run.over ? VIEW.alarm : null);\n\n  var wx = cardTopRight(b), wy = cardTopMid(b);\n  var cw = paintGooChip(wx, wy, walletShown());\n  if (!ghosting) scene.walletAt = cardHit({ x: wx - cw, y: wy - 8, w: cw, h: 16 });\n\n  var cnt = easeOut((age - OVER_COUNT.from) / OVER_COUNT.ms);\n  ctx.textAlign = 'center';\n  ctx.fillStyle = VIEW.ink;\n  ctx.font = FONT.huge(52);\n  cardLine(String(Math.round(run.score * cnt)), cx, 92, 'center');\n\n  var rec = run.score > (run.prevBest || 0);\n  var recK = easeOut((age - OVER_COUNT.from - OVER_COUNT.ms + 120) / 220);\n  ctx.save();\n  ctx.globalAlpha = base * recK;\n  if (rec) { ctx.translate(cx, 110); ctx.scale(1.3 - 0.3 * recK, 1.3 - 0.3 * recK); ctx.translate(-cx, -110); }\n  ctx.fillStyle = rec ? VIEW.goo.Y : VIEW.inkDim;\n  ctx.font = '700 12px system-ui, sans-serif';\n  cardLine(rec ? 'NEW BEST' : 'Best run: ' + (save.slimeBest || 0) + ' · ' + (save.bestShifts || 1) + ' shifts', cx, 114, 'center');\n  ctx.restore();\n\n  ctx.save();\n  ctx.globalAlpha = base * easeOut((age - 300) / 220);\n  ctx.fillStyle = VIEW.ink; ctx.font = '600 11px system-ui, sans-serif';\n  var cause = slimeSumpLine(slimeSumpCause(run));\n  if (cause) cardLine(cause, cx, 132, 'center');\n  ctx.fillStyle = VIEW.inkDim; ctx.font = 'italic 600 11px system-ui, sans-serif';\n  cardLine(foremanLine(run), cx, 148, 'center');\n  ctx.restore();\n\n  ctx.save();\n  ctx.globalAlpha = base * easeOut((age - 300) / 220);