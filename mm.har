            "mimeType": "application/javascript",
            "text": "if (typeof document !== 'undefined') {\n\n  var tile = 16, ox = 0, oy = 0, reach = 0;\n  var vw = 0, vh = 0;\n  var SAFE = { top: 0, bottom: 0 };\n\n  function pipeShape(type) { return type === 'filter' ? 'straight' : type; }\n\n  function buildPath(type, reach) {\n    type = pipeShape(type);\n    ctx.beginPath();\n    if (type === 'straight') { ctx.moveTo(0, -reach); ctx.lineTo(0, reach); }\n    else if (type === 'elbow') {\n\n      var d1 = 0, d2 = 1;\n      var cx = reach * (CFG.dx[d1] + CFG.dx[d2]);\n      var cy = reach * (CFG.dy[d1] + CFG.dy[d2]);\n      var e1x = CFG.dx[d1] * reach, e1y = CFG.dy[d1] * reach;\n      var e2x = CFG.dx[d2] * reach, e2y = CFG.dy[d2] * reach;\n      var a1 = Math.atan2(e1y - cy, e1x - cx);\n      var a2 = Math.atan2(e2y - cy, e2x - cx);\n      ctx.arc(cx, cy, reach, a1, a2, true);\n    }\n    else if (type === 'tee') {\n      ctx.moveTo(0, -reach); ctx.lineTo(0, reach);\n      ctx.moveTo(0, 0); ctx.lineTo(reach, 0);\n    }\n    else if (type === 'cross') {\n      ctx.moveTo(0, -reach); ctx.lineTo(0, reach);\n      ctx.moveTo(-reach, 0); ctx.lineTo(reach, 0);\n    }\n  }\n\n  function beginStroke(lw) { ctx.lineWidth = lw; ctx.lineCap = 'butt'; ctx.lineJoin = 'round'; }\n\n  function darken(hex, f) {\n    var r = parseInt(hex.substr(1, 2), 16), g = parseInt(hex.substr(3, 2), 16), b = parseInt(hex.substr(5, 2), 16);\n    r = Math.round(r * (1 - f)); g = Math.round(g * (1 - f)); b = Math.round(b * (1 - f));\n    return 'rgb(' + r + ',' + g + ',' + b + ')';\n  }\n\n  function lighten(hex, f) {\n    var r = parseInt(hex.substr(1, 2), 16), g = parseInt(hex.substr(3, 2), 16), b = parseInt(hex.substr(5, 2), 16);\n    r = Math.round(r + (255 - r) * f); g = Math.round(g + (255 - g) * f); b = Math.round(b + (255 - b) * f);\n    return 'rgb(' + r + ',' + g + ',' + b + ')';\n  }\n\n  function paintFlange(d, color) {\n    var w = tile * CFG.flangeWidth / 2;\n    var l = tile * CFG.flangeLen / 2;\n    var ux = CFG.dx[d], uy = CFG.dy[d];\n    var ex = ux * reach, ey = uy * reach;\n    ctx.save();\n    ctx.translate(ex, ey);\n    ctx.rotate(Math.atan2(uy, ux));\n    ctx.fillStyle = color;\n    ctx.beginPath();\n    ctx.roundRect(-l, -w, l * 2, w * 2, CFG.flangeRad);\n    ctx.fill();\n    ctx.restore();\n  }\n\n  function tubeRect(x0, y0, x1, y1, hw) {\n    if (x0 === x1) {\n      ctx.moveTo(x0 - hw, y0); ctx.lineTo(x1 - hw, y1);\n      ctx.lineTo(x1 + hw, y1); ctx.lineTo(x0 + hw, y0);\n    } else {\n\n      ctx.moveTo(x0, y0 + hw); ctx.lineTo(x1, y1 + hw);\n      ctx.lineTo(x1, y1 - hw); ctx.lineTo(x0, y0 - hw);\n    }\n    ctx.closePath();\n  }\n\n  function traceTube(type, hw) {\n    ctx.beginPath();\n    subTube(type, hw);\n  }\n\n  function subTube(type, hw) {\n    type = pipeShape(type);\n    if (type === 'straight') tubeRect(0, -reach, 0, reach, hw);\n    else if (type === 'elbow') {\n      var d1 = 0, d2 = 1;\n      var cx = reach * (CFG.dx[d1] + CFG.dx[d2]), cy = reach * (CFG.dy[d1] + CFG.dy[d2]);\n      var e1x = CFG.dx[d1] * reach, e1y = CFG.dy[d1] * reach;\n      var e2x = CFG.dx[d2] * reach, e2y = CFG.dy[d2] * reach;\n      var a1 = Math.atan2(e1y - cy, e1x - cx), a2 = Math.atan2(e2y - cy, e2x - cx);\n\n      ctx.moveTo(cx + (reach + hw) * Math.cos(a1), cy + (reach + hw) * Math.sin(a1));\n      ctx.arc(cx, cy, reach + hw, a1, a2, true);\n      ctx.arc(cx, cy, reach - hw, a2, a1, false);\n      ctx.closePath();\n    }\n    else if (type === 'tee') { tubeRect(0, -reach, 0, reach, hw); tubeRect(0, 0, reach, 0, hw); }\n    else if (type === 'cross') { tubeRect(0, -reach, 0, reach, hw); tubeRect(-reach, 0, reach, 0, hw); }\n  }\n\n  function pathRoundedRect(c, x, y, w, h, rad) {\n    c.beginPath();\n    c.moveTo(x + rad, y);\n    c.arcTo(x + w, y, x + w, y + h, rad);\n    c.arcTo(x + w, y + h, x, y + h, rad);\n    c.arcTo(x, y + h, x, y, rad);\n    c.arcTo(x, y, x + w, y, rad);\n    c.closePath();\n  }\n\n}\n"
