          "content": {
            "size": 4245,
            "mimeType": "application/javascript",
            "text": "var LOGO_W = 960, LOGO_H = 100, LOGO_STROKE = 24, LOGO_OUTLINE = 10;\nvar LOGO_LETTERS = [\n  { w: 6, space: true },\n  { w: 92, tilt: -1.5, strokes: [[[70, 20], [52, 8], [24, 14], [14, 34], [30, 50], [62, 56], [80, 72], [68, 92], [36, 97], [12, 84]]] },\n  { w: 84, tilt: 1.0, strokes: [[[20, 6], [20, 94], [80, 94]]] },\n  { w: 56, tilt: 0, strokes: [[[28, 6], [28, 94]]] },\n  { w: 104, tilt: -0.5, strokes: [[[14, 94], [14, 8], [52, 64], [90, 8], [90, 94]]] },\n  { w: 84, tilt: 1.5, strokes: [[[18, 6], [18, 94], [80, 94]], [[18, 6], [76, 6]], [[18, 50], [64, 50]]] },\n  { w: 56, space: true },\n  { w: 108, tilt: 0, strokes: [[[8, 6], [30, 94], [54, 34], [78, 94], [100, 6]]] },\n  { w: 92, drop: true },\n  { w: 90, tilt: 1.0, strokes: [[[18, 94], [18, 6], [62, 6], [80, 22], [78, 40], [60, 52], [18, 52]], [[48, 52], [84, 94]]] },\n  { w: 88, tilt: -1.0, strokes: [[[18, 6], [18, 94]], [[80, 6], [22, 56]], [[40, 44], [84, 94]]] },\n  { w: 92, tilt: 2.0, drip: true, strokes: [[[70, 20], [52, 8], [24, 14], [14, 34], [30, 50], [62, 56], [80, 72], [68, 92], [36, 97], [12, 84]]] }\n];\n\nfunction logoPath(pts) {\n  ctx.beginPath();\n  ctx.moveTo(pts[0][0], pts[0][1]);\n  if (pts.length === 2) { ctx.lineTo(pts[1][0], pts[1][1]); return; }\n  for (var i = 1; i < pts.length - 1; i++) {\n    var mx = (pts[i][0] + pts[i + 1][0]) / 2, my = (pts[i][1] + pts[i + 1][1]) / 2;\n    ctx.quadraticCurveTo(pts[i][0], pts[i][1], mx, my);\n  }\n  var l = pts[pts.length - 1];\n  ctx.lineTo(l[0], l[1]);\n}\n\nfunction logoStrokeWidth(pts) {\n  var sy = 0;\n  for (var i = 0; i < pts.length; i++) sy += pts[i][1];\n  return LOGO_STROKE * (sy / pts.length > 50 ? 1.12 : 1);\n}\n\nfunction logoPass(pass, fill, now) {\n  var x = 0, n = LOGO_LETTERS.length, i, j;\n  ctx.save();\n  ctx.lineCap = 'round'; ctx.lineJoin = 'round';\n  if (pass === 'shadow') ctx.translate(2, 3);\n  for (i = 0; i < n; i++) {\n    var L = LOGO_LETTERS[i];\n    if (L.space) { x += L.w; continue; }\n    var