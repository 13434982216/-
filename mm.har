            "mimeType": "application/javascript",
            "text": "var MUSIC = {\n  bpm: 96,\n  bpmMax: 118,\n  root: 57,\n  prog: [[0, 3, 7], [-4, 0, 3], [3, 7, 10], [-2, 2, 5]],\n  arpFrom: 2,\n  alarmFrom: 0.6,\n  doorOpen: 12000,\n  doorShut: 900,\n  outGain: 0.035\n};\n\nfunction midiHz(n) { return 440 * Math.pow(2, (n - 69) / 12); }\n\nfunction musicChord(bar) {\n  var ch = MUSIC.prog[((bar % MUSIC.prog.length) + MUSIC.prog.length) % MUSIC.prog.length];\n  return [MUSIC.root + ch[0], MUSIC.root + ch[1], MUSIC.root + ch[2]];\n}\n\nfunction musicClamp01(v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }\n\nfunction musicMix(st) {\n  var live = st.mode === 'run' && !st.over;\n  var drive = musicClamp01((st.rate - SLIME.rateStart) / (SLIME.rateMax - SLIME.rateStart));\n  if (!live) {\n    return { pad: 0.35, pulse: 0.15, arp: 0, alarm: 0, cutoff: MUSIC.doorShut, bpm: MUSIC.bpm };\n  }\n  return {\n    pad: 0.5,\n    pulse: 0.45 + 0.35 * drive,\n    arp: st.shift >= MUSIC.arpFrom ? 0.22 + 0.10 * musicClamp01((st.mult - 1) / 3) : 0,\n    alarm: musicClamp01((st.contam - MUSIC.alarmFrom) / (1 - MUSIC.alarmFrom)),\n    cutoff: MUSIC.doorOpen,\n    bpm: MUSIC.bpm + (MUSIC.bpmMax - MUSIC.bpm) * drive\n  };\n}\n\nif (typeof document !== 'undefined') {\n  var music = null;\n\n  function musicEnv(g, t0, a, peak, d, sus, r, t1) {\n    g.gain.cancelScheduledValues(t0);\n    g.gain.setValueAtTime(0.0001, t0);\n    g.gain.linearRampToValueAtTime(peak, t0 + a);\n    g.gain.setTargetAtTime(sus, t0 + a, d);\n    g.gain.setTargetAtTime(0.0001, t1, r);\n  }\n\n  function musicOsc(c, type, hz, detune) {\n    var o = c.createOscillator();\n    o.type = type; o.frequency.value = hz; o.detune.value = detune || 0;\n    return o;\n  }\n\n  function musicNoise(c) {\n    var n = Math.floor(c.sampleRate * 2);\n    var buf = c.createBuffer(1, n, c.sampleRate);\n    var d = buf.getChannelData(0), i;\n    for (i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;\n    var src = c.createBufferSource();\n    src.buffer = buf; src.loop = true;\n    return src;\n  }\n\n  function musicBuild(c, dest) {\n    var m = { c: c, at: 0, bar: 0, step: 0, bpm: MUSIC.bpm, mix: null, solo: null, timer: null };\n    m.out = c.createGain(); m.out.gain.value = MUSIC.outGain;\n    m.door = c.createBiquadFilter(); m.door.type = 'lowpass'; m.door.frequency.value = MUSIC.doorShut; m.door.Q.value = 0.5;\n    m.out.connect(m.door); m.door.connect(dest);\n\n    m.pad = c.createGain(); m.pad.gain.value = 0;\n    m.padLp = c.createBiquadFilter(); m.padLp.type = 'lowpass'; m.padLp.frequency.value = 700; m.padLp.Q.value = 0.7;\n    m.padLfo = musicOsc(c, 'sine', 0.08); m.padLfoG = c.createGain(); m.padLfoG.gain.value = 250;\n    m.padLfo.connect(m.padLfoG); m.padLfoG.connect(m.padLp.frequency); m.padLfo.start();\n    m.padLp.connect(m.pad); m.pad.connect(m.out);\n\n    m.pulse = c.createGain(); m.pulse.gain.value = 0;\n    m.pulseLp = c.createBiquadFilter(); m.pulseLp.type = 'lowpass'; m.pulseLp.frequency.value = 260;\n    m.pulseLp.connect(m.pulse); m.pulse.connect(m.out);\n\n    m.arp = c.createGain(); m.arp.gain.value = 0;\n    m.arpDelay = c.createDelay(1.0); m.arpFb = c.createGain(); m.arpFb.gain.value = 0.35;\n    m.arpHp = c.createBiquadFilter(); m.arpHp.type = 'highpass'; m.arpHp.frequency.value = 500;\n    m.arpHp.connect(m.arp); m.arp.connect(m.out);\n    m.arp.connect(m.arpDelay); m.arpDelay.connect(m.arpFb); m.arpFb.connect(m.arpDelay); m.arpDelay.connect(m.out);\n\n    m.alarm = c.createGain(); m.alarm.gain.value = 0;\n    m.alarmBp = c.createBiquadFilter(); m.alarmBp.type = 'bandpass'; m.alarmBp.frequency.value = 900; m.alarmBp.Q.value = 2;\n    m.alarmA = musicOsc(c, 'sawtooth', midiHz(MUSIC.root + 6)); m.alarmB = musicOsc(c, 'sawtooth', midiHz(MUSIC.root + 6), 9);\n    m.alarmA.connect(m.alarmBp); m.alarmB.connect(m.alarmBp);\n    m.alarmNoise = musicNoise(c);\n    m.alarmNoiseG = c.createGain(); m.alarmNoiseG.gain.value = 0.5;\n    m.alarmNoise.connect(m.alarmNoiseG); m.alarmNoiseG.connect(m.alarmBp);\n    m.alarmBp.connect(m.alarm); m.alarm.connect(m.out);\n    m.alarmTremNode = c.createGain(); m.alarmTremNode.gain.value = 0.5;\n    m.alarmTrem = musicOsc(c, 'sine', 2.2); m.alarmTremG = c.createGain(); m.alarmTremG.gain.value = 0.5;\n    m.alarmTrem.connect(m.alarmTremG); m.alarmTremG.connect(m.alarmTremNode.gain);\n    m.alarmBp.disconnect(); m.alarmBp.connect(m.alarmTremNode); m.alarmTremNode.connect(m.alarm);\n    m.alarmA.start(); m.alarmB.start(); m.alarmTrem.start(); m.alarmNoise.start();\n    return m;\n  }\n\n  function musicBeat(m) { return 60 / m.bpm; }\n\n  function musicSchedulePad(m, t0) {\n    var notes = musicChord(m.bar), len = musicBeat(m) * 4, i, o1, o2, g;\n    for (i = 0; i < notes.length; i++) {\n      g = m.c.createGain();\n      o1 = musicOsc(m.c, 'sawtooth', midiHz(notes[i]), -6);\n      o2 = musicOsc(m.c, 'sawtooth', midiHz(notes[i]), 6);\n      o1.connect(g); o2.connect(g); g.connect(m.padLp);\n      musicEnv(g, t0, 0.4, 0.12, 0.3, 0.10, 0.6, t0 + len - 0.4);\n      o1.start(t0); o2.start(t0); o1.stop(t0 + len + 1.5); o2.stop(t0 + len + 1.5);\n    }\n  }\n\n  function musicSchedulePulse(m, t0, step) {\n    var o = musicOsc(m.c, 'triangle', midiHz(musicChord(m.bar)[0] - 12)), g = m.c.createGain();\n    var accent = (step % 4) === 0 ? 1 : 0.7;\n    o.connect(g); g.connect(m.pulseLp);\n    musicEnv(g, t0, 0.005, 0.5 * accent, 0.12, 0.0001, 0.05, t0 + 0.18);\n    o.start(t0); o.stop(t0 + 0.5);\n  }\n\n  var ARP_PATTERN = [0, 1, 2, 1, 0, 2, 1, 2];\n  function musicScheduleArp(m, t0, step) {\n    var notes = musicChord(m.bar), n = notes[ARP_PATTERN[step % ARP_PATTERN.length]] + 12 + (step % 16 >= 8 ? 12 : 0);\n    var o = musicOsc(m.c, 'triangle', midiHz(n)), g = m.c.createGain();\n    o.connect(g); g.connect(m.arpHp);\n    musicEnv(g, t0, 0.008, 0.35, 0.08, 0.0001, 0.04, t0 + 0.11);\n    o.start(t0); o.stop(t0 + 0.4);\n  }\n\n  var MUSIC_LOOKAHEAD = 0.14, MUSIC_TICK_MS = 25;\n  function musicTick() {\n    var m = music; if (!m) return;\n    var now = m.c.currentTime, sixteenth = musicBeat(m) / 4;\n    while (m.at < now + MUSIC_LOOKAHEAD) {\n      if (m.step % 16 === 0) musicSchedulePad(m, m.at);\n      if (m.step % 2 === 0) musicSchedulePulse(m, m.at, m.step / 2);\n      if (m.mix && m.mix.arp > 0) musicScheduleArp(m, m.at, m.step);\n      m.at += sixteenth;\n      m.step++;\n      if (m.step % 16 === 0) { m.bar++; if (m.mix) m.bpm = m.mix.bpm; }\n    }\n    m.arpDelay.delayTime.setTargetAtTime(musicBeat(m) * 0.75, now, 0.2);\n  }\n\n  function musicStart() {\n    if (music || !audioCtx) return;\n    music = musicBuild(audioCtx, audioMusicBus());\n    music.at = audioCtx.currentTime + 0.05;\n    music.timer = setInterval(musicTick, MUSIC_TICK_MS);\n  }\n\n  function musicStop() {\n    if (!music) return;\n    clearInterval(music.timer);\n    music.out.gain.setTargetAtTime(0.0001, music.c.currentTime, 0.1);\n    var dead = music, t = music.c.currentTime + 0.6; music = null;\n    dead.padLfo.stop(t); dead.alarmA.stop(t); dead.alarmB.stop(t); dead.alarmTrem.stop(t); dead.alarmNoise.stop(t);\n    setTimeout(function () { try { dead.door.disconnect(); } catch (e) {} }, 700);\n  }\n\n  function musicApply(mix) {\n    var m = music; if (!m) return;\n    var t = m.c.currentTime, k = m.solo;\n    function lv(name) { return k && k !== name ? 0 : mix[name]; }\n    m.pad.gain.setTargetAtTime(lv('pad'), t, 0.25);\n    m.pulse.gain.setTargetAtTime(lv('pulse'), t, 0.25);\n    m.arp.gain.setTargetAtTime(lv('arp'), t, 0.25);\n    m.alarm.gain.setTargetAtTime(lv('alarm') * 0.5, t, 0.25);\n    m.door.frequency.setTargetAtTime(mix.cutoff, t, 0.15);\n    m.mix = mix;\n  }\n\n  function musicSolo(name) { if (music) music.solo = name || null; }\n\n  var MUSIC_DUCK_TAU = 0.06, MUSIC_DUCK_BACK_TAU = 0.16;\n\n  function musicDuck(on) {\n    if (!music) return;\n    music.out.gain.setTargetAtTime(on ? 0.0001 : MUSIC.outGain, music.c.currentTime, on ? MUSIC_DUCK_TAU : MUSIC_DUCK_BACK_TAU);\n  }\n}\n"
