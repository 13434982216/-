, 'right');\n  uiHud('темп и смена', { x: tagR - tagW, y: numY - 26, w: tagW, h: 30 }, tagW);\n\n  var bx = col.x, bw = col.w, by = barY, bh = barH();\n  var slag = !!(cur.flow && slimeHasSlag(cur.flow));\n  drawGauge(bx, by, bw, bh, k, slag, now);\n  ctx.restore();\n}\n\nfunction gaugeFill(rx, ry, rw, rh, k, crit, now) {\n  var i;\n  ctx.fillStyle = rgba(VIEW.alarm, 0.22); ctx.fillRect(rx + rw * crit, ry, rw * (1 - crit), rh);\n  ctx.fillStyle = sludgeColor(k); ctx.fillRect(rx, ry, rw * k, rh);\n  ctx.globalAlpha = 0.28; ctx.fillStyle = '#000';\n  for (i = ((now / 24) % 20); i < rw * k; i += 20) ctx.fillRect(rx + i, ry, 6, rh);\n  ctx.globalAlpha = 1;\n  ctx.fillStyle = lighten(sludgeColor(k), 0.25); ctx.fillRect(rx + rw * k - 2, ry, 2, rh);\n  ctx.save(); ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = 0.30;\n  ctx.fillStyle = sludgeColor(k); ctx.fillRect(rx + Math.max(0, rw * k - 12), ry, Math.min(12, rw * k), rh);\n  ctx.restore();\n}\n\nfunction drawGauge(x, y, w, h, k, slag, now) {\n  var crit = SLIME.criticalAt, i;\n  var fg = uiFrame('glass'), gl = fg && uiStamp('glass', w, h, h, uiMetal());\n  if (gl) {\n    var s = h / fg.unit, win = uiWin(fg, x, y, w, s), lit = k > crit, lamp = uiFrame(lit ? 'lampOn' : 'lampOff');\n    ctx.save();\n    ctx.beginPath(); ctx.rect(win.x, win.y, win.w, win.h); ctx.clip();\n    ctx.fillStyle = '#070c0a'; ctx.fillRect(win.x, win.y, win.w, win.h);\n    gaugeFill(win.x, win.y, win.w, win.h, k, crit, now);\n    ctx.restore();\n    ctx.drawImage(gl, x, y, w, h);\n    var nx = win.x + win.w * k;\n    ctx.fillStyle = VIEW.ink;\n    ctx.beginPath(); ctx.moveTo(nx, y + h + 1); ctx.lineTo(nx - 6, y + h + 9); ctx.lineTo(nx + 6, y + h + 9); ctx.closePath(); ctx.fill();\n    if (lamp) {\n      var ld = h * 0.9, lx = x + w - (fg.w - fg.win[2]) * s / 2, ly = y + h / 2;\n      ctx.save();\n      if (lit) ctx.globalAlpha = 0.55 + 0.45 * osc01(now, PULSE.alarm);\n      ctx.drawImage(artImg('ui'), lamp.x, lamp.y, lamp.w, lamp.h, lx -