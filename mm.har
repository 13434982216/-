            "text": "var ART = { ready: false, img: {}, progress: 0, failed: [] };\nvar ART_LOAD_TIMEOUT_MS = 8000;\n\nfunction artPlan(man) {\n  var n = 0, bytes = 0, bad = [], k, e;\n  for (k in man) {\n    e = man[k];\n    if (!e || typeof e.file !== 'string' || e.file.charAt(0) === '/' || e.file.indexOf('://') >= 0 ||\n        !(e.w > 0) || !(e.h > 0)) { bad.push(k); continue; }\n    n++; bytes += e.bytes || 0;\n  }\n  return { n: n, bytes: bytes, bad: bad };\n}\n\nfunction artScale(key, wantPx, srcPx) { return wantPx / srcPx; }\n\nfunction uiNineLayout(cols, rows, w, h, s) {\n  function axis(c, size) {\n    if (!c) return [{ d0: 0, d1: size, s0: 0, s1: null }];\n    var a = (c[1] - c[0]) * s, b = (c[4] - c[3]) * s, t = (c[2] - c[1]) * s, k, out, x, d1;\n    if (a + b > size) { k = size / (a + b); a *= k; b *= k; }\n    out = [{ d0: 0, d1: a, s0: c[0], s1: c[1] }];\n    for (x = a; x < size - b - 1e-6 && t > 0; x += t) {\n      d1 = Math.min(x + t, size - b);\n      out.push({ d0: x, d1: d1, s0: c[1], s1: c[1] + (d1 - x) / s });\n    }\n    out.push({ d0: size - b, d1: size, s0: c[3], s1: c[4] });\n    return out;\n  }\n  return { x: axis(cols, w), y: axis(rows, h) };\n}\n\nif (typeof document !== 'undefined') {\n  function artLoad(onProgress, onDone) {\n    var man = typeof ART_MANIFEST === 'object' ? ART_MANIFEST : {};\n    var plan = artPlan(man), keys = [], k, i, left, finished = false;\n    for (k in man) if (plan.bad.indexOf(k) < 0) keys.push(k);\n    left = keys.length;\n    function finish() {\n      if (finished) return; finished = true;\n      ART.ready = true;\n      onDone();\n    }\n    if (!left) { finish(); return; }\n    function one(key) {\n      var img = new Image();\n      img.onload = function () { ART.img[key] = img; left--; ART.progress = 1 - left / keys.length; onProgress(ART.progress); if (!left) finish(); };\n      img.onerror = function () { ART.failed.push(key); left--; ART.progress = 1 - left / keys.length; onProgress(ART.progress); if (!left) finish(); };\n      img.src = man[key].file;\n    }\n    for (i = 0; i < keys.length; i++) one(keys[i]);\n    setTimeout(finish, ART_LOAD_TIMEOUT_MS);\n  }\n}\n"
