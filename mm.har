= by || 'user';\n  PAUSE.hadCard = false;\n  scene.armTool = null;\n  sceneGo('pause');\n  scene.pauseBtns = null;\n  slimeHum(false);\n  return true;\n}\n\nfunction slimeResume() {\n  if (MODE !== 'pause') return;\n  PAUSE.by = '';\n  sceneGo('run');\n  lastT = 0;\n}\n\nvar SDK_AD = { ready: false, active: false, shown: false, lastAt: -1e9, pending: null, timer: null, waitMs: 1500, rewardToken: 0 };\n\nfunction slimeSdkEvent(name) {\n  if (name === 'SDK_READY') { SDK_AD.ready = true; return; }\n  if (name === 'SDK_GAME_PAUSE') {\n    SDK_AD.active = true; SDK_AD.shown = true;\n    if (SDK_AD.timer) { clearTimeout(SDK_AD.timer); SDK_AD.timer = null; }\n    if (MODE === 'run') slimePause('ad');\n    slimeHum(false);\n    audioSilence();\n    return;\n  }\n  if (name === 'SDK_GAME_START') {\n    SDK_AD.active = false;\n    audioSetLevels();\n    if (MODE === 'pause' && PAUSE.by === 'ad') {\n      if (slimeNetHolds()) PAUSE.by = 'user';\n      else slimeResume();\n    }\n    slimeAdDrain();\n  }\n}\n\nfunction slimeAdDrain() {\n  var p = SDK_AD.pending, shown = SDK_AD.shown;\n  SDK_AD.pending = null; SDK_AD.shown = false;\n  if (SDK_AD.timer) { clearTimeout(SDK_AD.timer); SDK_AD.timer = null; }\n  if (p) p();\n  if (shown && slimeNetHolds() && MODE === 'run') slimePause('user');\n}\n\nfunction slimeNetShow(kind, done) {\n  var w = typeof window !== 'undefined' ? window : null;\n  if (w && typeof w.slimeNetAd === 'function') { w.slimeNetAd(kind, done); return true; }\n  if (kind === 'midroll' && w && w.sdk && typeof w.sdk.showBanner === 'function') { w.sdk.showBanner(); return true; }\n  return false;\n}\n\nfunction slimeAdsRewarded() {\n  return SDK_AD.ready && typeof window !== 'undefined' && typeof window.slimeNetAd === 'function' &&\n         window.slimeNetRewarded !== false;\n}\n\nfunction slimeNetHolds() {\n  return typeof window !== 'undefined' && window.slimeNetPauseAfterAd === true;\n}\n\nfunction slimePreroll(then) {\n  if (SDK_AD.pending) return;\n  var w = 