            "text": "function conns(tile) {\n  var base = CFG.baseConnectors[tile.type] || [];\n  var r = ((tile.rot % 4) + 4) % 4;\n  if (r === 0) return base.slice();\n  return base.map(function (d) { return (d + r) % 4; });\n}\n\nvar MAXG = 2;\n\nfunction groups(tile) {\n  var base = CFG.connectorGroups[tile.type] || [];\n  var r = ((tile.rot % 4) + 4) % 4;\n  var out = [];\n  for (var i = 0; i < base.length; i++) {\n    var g = [];\n    for (var j = 0; j < base[i].length; j++) g.push((base[i][j] + r) % 4);\n    out.push(g);\n  }\n  return out;\n}\n\nfunction groupOf(tile, d) {\n  var gs = groups(tile);\n  for (var i = 0; i < gs.length; i++) if (gs[i].indexOf(d) !== -1) return i;\n  return -1;\n}\n\nvar MASK_BY_COLOR = (function () {\n  var m = {};\n  for (var k in CFG.colorByMask) m[CFG.colorByMask[k]] = Number(k);\n  return m;\n})();\n\nfunction colorMask(color) {\n  return MASK_BY_COLOR[color] || 0;\n}\n\nfunction mix2(a, b) {\n  return CFG.colorByMask[colorMask(a) | colorMask(b)] || null;\n}\n\nfunction filterColor(color, sub) {\n  if (color == null) return null;\n  return CFG.colorByMask[colorMask(color) & ~colorMask(sub)] || null;\n}\n\nfunction mixColors(colors) {\n  if (!colors || colors.length === 0) return null;\n  var r = colors[0];\n  for (var i = 1; i < colors.length; i++) r = mix2(r, colors[i]);\n  return r;\n}\n\nfunction computeFlow(grid) {\n  var n = grid.length, W = grid[0].length, N = n * W * MAXG;\n  var col = [], dist = [];\n  for (var i = 0; i < N; i++) { col.push(null); dist.push(-1); }\n  function key(r, c, g) { return (r * W + c) * MAXG + g; }\n\n  var gs = [];\n  for (var r = 0; r < n; r++) { gs.push([]); for (var c = 0; c < W; c++) gs[r].push(groups(grid[r][c])); }\n\n  function nb(r, c, d) {\n    var nr = r + CFG.dy[d], nc = c + CFG.dx[d];\n    if (nr < 0 || nr >= n || nc < 0 || nc >= W) return null;\n    var back = (d + 2) % 4, ngs = gs[nr][nc];\n    for (var gi = 0; gi < ngs.length; gi++) if (ngs[gi].indexOf(back) !== -1) return [nr, nc, gi];\n    return null;\n  }\n\n  var q = [];\n  for (r = 0; r < n; r++) for (c = 0; c < W; c++)\n    if (grid[r][c].type === 'source') { var ks = key(r, c, 0); col[ks] = grid[r][c].color; dist[ks] = 0; q.push([r, c, 0]); }\n\n  var head = 0;\n  while (head < q.length) {\n    var cu = q[head++], cr = cu[0], cc = cu[1], cg = cu[2];\n    var dirs = gs[cr][cc][cg];\n    for (var di = 0; di < dirs.length; di++) {\n      var t = nb(cr, cc, dirs[di]);\n      if (!t) continue;\n      var kt = key(t[0], t[1], t[2]);\n      if (dist[kt] === -1) { dist[kt] = dist[key(cr, cc, cg)] + 1; q.push(t); }\n    }\n  }\n  function reach(r, c, g) { return dist[key(r, c, g)] >= 0; }\n\n  var incoming = [], flatIn = [], flatOut = [];\n  for (i = 0; i < N; i++) { incoming.push([]); flatIn.push(0); flatOut.push([]); }\n\n  function deeper(r, c, g) {\n    var dd = gs[r][c][g];\n    for (var i2 = 0; i2 < dd.length; i2++) {\n      var t2 = nb(r, c, dd[i2]);\n      if (t2 && dist[key(t2[0], t2[1], t2[2])] === dist[key(r, c, g)] + 1) return true;\n    }\n    return false;\n  }\n\n  for (r = 0; r < n; r++) for (c = 0; c < W; c++) for (var g = 0; g < gs[r][c].length; g++) {\n    if (!reach(r, c, g) || grid[r][c].type === 'source') continue;\n    var ds = gs[r][c][g];\n    for (var j = 0; j < ds.length; j++) {\n      var s = nb(r, c, ds[j]);\n      if (!s || !reach(s[0], s[1], s[2])) continue;\n      if (dist[key(s[0], s[1], s[2])] < dist[key(r, c, g)]) incoming[key(r, c, g)].push(s);\n    }\n  }\n\n  var seen = {};\n  for (r = 0; r < n; r++) for (c = 0; c < W; c++) for (g = 0; g < gs[r][c].length; g++) {\n    if (!reach(r, c, g)) continue;\n    var ds2 = gs[r][c][g];\n    for (var j2 = 0; j2 < ds2.length; j2++) {\n      var o = nb(r, c, ds2[j2]);\n      if (!o || !reach(o[0], o[1], o[2])) continue;\n      if (grid[o[0]][o[1]].type === 'source') continue;\n      var ka = key(r, c, g), kb = key(o[0], o[1], o[2]);\n      if (dist[ka] !== dist[kb]) continue;\n      var pair = Math.min(ka, kb) + '_' + Math.max(ka, kb);\n      if (seen[pair]) continue; seen[pair] = true;\n      var toB;\n      var dA = deeper(r, c, g), dB = deeper(o[0], o[1], o[2]);\n      if (dB && !dA) toB = true;\n      else if (dA && !dB) toB = false;\n      else toB = ka < kb;\n      if (toB) { incoming[kb].push([r, c, g]); flatOut[ka].push(o); flatIn[kb]++; }\n      else { incoming[ka].push(o); flatOut[kb].push([r, c, g]); flatIn[ka]++; }\n    }\n  }\n\n  var fdep = [];\n  for (i = 0; i < N; i++) fdep.push(dist[i] < 0 ? -1 : 0);\n\n  var maxd = 0;\n  for (i = 0; i < N; i++) if (dist[i] > maxd) maxd = dist[i];\n  for (var layer = 0; layer <= maxd; layer++) {\n    var ready = [];\n    for (r = 0; r < n; r++) for (c = 0; c < W; c++) for (g = 0; g < gs[r][c].length; g++)\n      if (reach(r, c, g) && dist[key(r, c, g)] === layer && flatIn[key(r, c, g)] === 0) ready.push([r, c, g]);\n    var rd = 0;\n    while (rd < ready.length) {\n      var p = ready[rd++], pr = p[0], pc = p[1], pg = p[2], kp = key(pr, pc, pg);\n      if (grid[pr][pc].type !== 'source') {\n        var inc = incoming[kp], cols = [], deepest = -1;\n        for (var m = 0; m < inc.length; m++) {\n          var ki = key(inc[m][0], inc[m][1], inc[m][2]);\n          var sc = col[ki]; if (sc != null) cols.push(sc);\n          if (fdep[ki] > deepest) deepest = fdep[ki];\n        }\n        fdep[kp] = deepest + 1;\n        col[kp] = cols.length ? mixColors(cols) : null;\n        if (grid[pr][pc].type === 'filter') col[kp] = filterColor(col[kp], grid[pr][pc].sub);\n      }\n      var fo = flatOut[kp];\n      for (var fi = 0; fi < fo.length; fi++) {\n        var kt2 = key(fo[fi][0], fo[fi][1], fo[fi][2]);\n        flatIn[kt2]--;\n        if (flatIn[kt2] === 0) ready.push(fo[fi]);\n      }\n    }\n  }\n\n  var out = [], arms = [];\n  for (r = 0; r < n; r++) {\n    out.push([]); arms.push([]);\n    for (c = 0; c < W; c++) {\n      var per = [];\n      for (g = 0; g < gs[r][c].length; g++) per.push(col[key(r, c, g)]);\n      out[r].push(per);\n      var a = {};\n      for (g = 0; g < gs[r][c].length; g++) {\n        var dl = gs[r][c][g];\n        for (var q2 = 0; q2 < dl.length; q2++) a[dl[q2]] = col[key(r, c, g)];\n      }\n      arms[r].push(a);\n    }\n  }\n  out.armColors = arms;\n\n  var depth = [], into = [];\n  for (r = 0; r < n; r++) {\n    depth.push([]); into.push([]);\n    for (c = 0; c < W; c++) {\n      var dep = [], inn = [];\n      for (g = 0; g < gs[r][c].length; g++) {\n        dep.push(fdep[key(r, c, g)]);\n        var mark = [false, false, false, false], inc2 = incoming[key(r, c, g)];\n        for (var m2 = 0; m2 < inc2.length; m2++)\n          for (var d2 = 0; d2 < 4; d2++)\n            if (r + CFG.dy[d2] === inc2[m2][0] && c + CFG.dx[d2] === inc2[m2][1]) mark[d2] = true;\n        inn.push(mark);\n      }\n      depth[r].push(dep); into[r].push(inn);\n    }\n  }\n  out.depth = depth;\n  out.inArm = into;\n  return out;\n}\n\nfunction bfsDepth(grid) {\n  var n = grid.length, W = grid[0].length, depth = [], gs = [];\n  for (var r = 0; r < n; r++) {\n    depth.push([]); gs.push([]);\n    for (var c = 0; c < W; c++) {\n      gs[r].push(groups(grid[r][c]));\n      var per = [];\n      for (var g = 0; g < gs[r][c].length; g++) per.push(-1);\n      depth[r].push(per);\n    }\n  }\n  var q = [];\n  for (r = 0; r < n; r++) for (c = 0; c < W; c++)\n    if (grid[r][c].type === 'source') { depth[r][c][0] = 0; q.push([r, c, 0]); }\n  var head = 0;\n  while (head < q.length) {\n    var cu = q[head++], cr = cu[0], cc = cu[1], cg = cu[2];\n    var dirs = gs[cr][cc][cg];\n    for (var i = 0; i < dirs.length; i++) {\n      var d = dirs[i], nr = cr + CFG.dy[d], nc = cc + CFG.dx[d];\n      if (nr < 0 || nr >= n || nc < 0 || nc >= W) continue;\n      var back = (d + 2) % 4, ngs = gs[nr][nc], ng = -1;\n      for (var gi = 0; gi < ngs.length; gi++) if (ngs[gi].indexOf(back) !== -1) ng = gi;\n      if (ng === -1) continue;\n      if (depth[nr][nc][ng] === -1) { depth[nr][nc][ng] = depth[cr][cc][cg] + 1; q.push([nr, nc, ng]); }\n    }\n  }\n  return depth;\n}\n\nfunction parToSolve(grid, solution) {\n  var total = 0;\n  for (var r = 0; r < grid.length; r++)\n    for (var c = 0; c < grid[r].length; c++) {\n      if (grid[r][c].fixed) continue;\n      total += ((solution[r][c].rot - grid[r][c].rot) % 4 + 4) % 4;\n    }\n  return total;\n}\n\nfunction connSetKey(type, rot) {\n  return conns({ type: type, rot: ((rot % 4) + 4) % 4 })\n    .slice().sort(function (a, b) { return a - b; }).join(',');\n}\n\nfunction rotCost(type, from, to) {\n  var target = connSetKey(type, to), best = null;\n  for (var k = 0; k < 4; k++) {\n    if (connSetKey(type, from + k) !== target) continue;\n    var cost = Math.min(k, 4 - k);\n    if (best === null || cost < best) best = cost;\n  }\n  return best === null ? 0 : best;\n}\n\nfunction rotCostFwd(type, from, to) {\n  var target = connSetKey(type, to);\n  for (var k = 0; k < 4; k++) if (connSetKey(type, from + k) === target) return k;\n  return 0;\n}\n\nfunction tileCap(type, solRot) {\n  var best = 0;\n  for (var k = 0; k < 4; k++) {\n    var cost = rotCost(type, solRot + k, solRot);\n    if (cost > best) best = cost;\n  }\n  return best;\n}\n\nfunction honestPar(grid, solution) {\n  var f = computeFlow(solution), total = 0;\n  for (var r = 0; r < grid.length; r++)\n    for (var c = 0; c < grid[r].length; c++) {\n      var t = grid[r][c];\n      if (t.fixed || t.type === 'empty') continue;\n      if (f[r][c][0] == null) continue;\n      total += rotCost(t.type, t.rot, solution[r][c].rot);\n    }\n  return total;\n}\n\nfunction outputsSatisfiedIn(grid, f) {\n  for (var r = 0; r < grid.length; r++)\n    for (var c = 0; c < grid[r].length; c++)\n      if (grid[r][c].type === 'output' && f[r][c][0] !== grid[r][c].need) return false;\n  return true;\n}\n\nfunction dryPipesIn(grid, f) {\n  var out = [];\n  for (var r = 0; r < grid.length; r++)\n    for (var c = 0; c < grid[r].length; c++) {\n      var t = grid[r][c];\n      if (t.type === 'empty' || t.type === 'source' || t.type === 'output') continue;\n      for (var g = 0; g < f[r][c].length; g++)\n        if (f[r][c][g] == null) { out.push({ r: r, c: c }); break; }\n    }\n  return out;\n}\n\nfunction dryStallIn(grid, f) {\n  if (!outputsSatisfiedIn(grid, f)) return null;\n  var dry = dryPipesIn(grid, f);\n  return dry.length ? dry : null;\n}\n\nfunction allOutputsSatisfied(grid) {\n  return outputsSatisfiedIn(grid, computeFlow(grid));\n}\n\nfunction allPipesWet(grid) {\n  return dryPipesIn(grid, computeFlow(grid)).length === 0;\n}\n\nfunction gridTeaches(grid) {\n  var out = { drain: false, filter: false };\n  for (var r = 0; r < grid.length; r++)\n    for (var c = 0; c < grid[r].length; c++) {\n      var t = grid[r][c];\n      if (t.type === 'output' && t.need === 'SLAG') out.drain = true;\n      if (t.type === 'filter') out.filter = true;\n    }\n  return out;\n}\n\nfunction streakAfterWin(daily, streak, todayKey, yesterdayKey) {\n  if (daily && daily[todayKey]) return streak || 0;\n  return (daily && daily[yesterdayKey]) ? (streak || 0) + 1 : 1;\n}\n\nfunction streakShown(daily, streak, todayKey, yesterdayKey) {\n  if (!daily || (!daily[todayKey] && !daily[yesterdayKey])) return 0;\n  return streak || 0;\n}\n\nfunction parBudget(opt) {\n  var o = opt > 0 ? opt : 1;\n  return Math.max(o + 1, Math.round(o * CFG.ui.parSlack));\n}\n\nfunction starsFor(moves, opt, budget) {\n  var o = opt > 0 ? opt : 1;\n  var b = budget > o ? budget : o + 1;\n  if (moves <= o) return 3;\n  if (moves <= b) return 2;\n  return 1;\n}\n\nfunction levelSolved(grid) {\n  return allPipesWet(grid) && allOutputsSatisfied(grid);\n}\n\nfunction coreCloneGrid(g) {\n  return g.map(function (row) {\n    return row.map(function (t) {\n      return { type: t.type, rot: t.rot, fixed: !!t.fixed, color: t.color, need: t.need, sub: t.sub };\n    });\n  });\n}\n\nfunction scrambleToTarget(solution, target, rng) {\n  var f = computeFlow(solution), n = solution.length, W = solution[0].length, slots = [], capTotal = 0;\n  for (var r = 0; r < n; r++)\n    for (var c = 0; c < W; c++) {\n      var t = solution[r][c];\n      if (t.fixed || t.type === 'empty' || f[r][c][0] == null) continue;\n      var cap = tileCap(t.type, t.rot);\n      if (cap > 0) { slots.push({ r: r, c: c, cap: cap }); capTotal += cap; }\n    }\n\n  if (capTotal === 0) return coreCloneGrid(solution);\n  var want = Math.max(1, Math.min(target, capTotal));\n  var grid = null;\n  for (var attempt = 0; attempt < 32; attempt++) {\n    grid = coreCloneGrid(solution);\n    for (var dr = 0; dr < n; dr++)\n      for (var dc = 0; dc < W; dc++) {\n        var dt = grid[dr][dc];\n        if (dt.fixed || dt.type === 'empty' || f[dr][dc][0] != null) continue;\n        dt.rot = Math.floor(rng() * 4) % 4;\n      }\n    var cost = [];\n    for (var i = 0; i < slots.length; i++) cost.push(0);\n    var placed = 0, guard = 0;\n    while (placed < want && guard++ < 10000) {\n      var pick = Math.floor(rng() * slots.length) % slots.length;\n      if (cost[pick] >= slots[pick].cap) continue;\n      cost[pick]++; placed++;\n    }\n    for (var j = 0; j < slots.length; j++) {\n      var sl = slots[j], solTile = solution[sl.r][sl.c], opts = [];\n\n      for (var rr = 0; rr < 4; rr++)\n        if (rotCostFwd(solTile.type, rr, solTile.rot) === cost[j]) opts.push(rr);\n      grid[sl.r][sl.c].rot = opts[Math.floor(rng() * opts.length) % opts.length];\n    }\n    if (!levelSolved(grid)) return grid;\n\n    if (attempt % 8 === 7 && want < capTotal) want++;\n  }\n\n  return grid;\n}\n\nfunction levelCapacity(solution) {\n  var f = computeFlow(solution), cap = 0;\n  for (var r = 0; r < solution.length; r++)\n    for (var c = 0; c < solution[r].length; c++) {\n      var t = solution[r][c];\n      if (t.fixed || t.type === 'empty' || f[r][c][0] == null) continue;\n      cap += tileCap(t.type, t.rot);\n    }\n  return cap;\n}\n\nfunction targetMoves(solution, moves) {\n  var cap = levelCapacity(solution);\n  if (cap <= 0) return 0;\n  var t = Math.round(moves.frac * cap);\n  if (t < moves.min) t = moves.min;\n  if (t > moves.max) t = moves.max;\n  if (t > cap) t = cap;\n  return t < 1 ? 1 : t;\n}\n"
