 : amount));\n  return run;\n}\n\nfunction slimeSumpCause(run) {\n  var d = run.dirt, best = null, total = 0, k;\n  if (!d) return null;\n  for (k in d) { total += d[k]; if (!best || d[k] > d[best]) best = k; }\n  return total < 0.05 ? null : best;\n}\n\nvar SUMP_LINE = {\n  wrong: 'Wrong colour filled the sump. Read the vats.',\n  late: 'Late orders filled the sump. Route faster.',\n  slag: 'Sludge filled the sump. Three colours, one pipe.',\n  leak: 'An open leak filled the sump. Tap it shut.',\n  night: 'The night filled the sump. Keep delivering.'\n};\nfunction slimeSumpLine(cause) { return cause ? SUMP_LINE[cause] : ''; }\n\nfunction slimeDailySeed(d) {\n  var s = (d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate()) >>> 0;\n  return (s * 2654435761) >>> 0;\n}\n\nfunction slimeLeakPick(grid, flow, rng) {\n  var out = [], r, c;\n  for (r = 0; r < grid.length; r++) for (c = 0; c < grid[r].length; c++) {\n    var t = grid[r][c];\n    if (t.fixed || t.type === 'empty' || t.type === 'source' || t.type === 'output') continue;\n    if (t.leak) continue;\n    if (flow[r][c][0] == null) continue;\n    out.push({ r: r, c: c });\n  }\n  if (!out.length) return null;\n  return out[Math.floor(rng() * out.length) % out.length];\n}\n\nfunction slimeLeakPatch(run, t) {\n  if (!t.leak) return false;\n  t.leak = 0;\n  run.leakOpen = null;\n  run.patched = (run.patched || 0) + 1;\n  return true;\n}\n\nvar GOO_NAME = { R: 'red', Y: 'yellow', B: 'blue', O: 'orange', G: 'green', P: 'purple' };\n\nfunction slimeIsMixed(c) { return CFG.secondaryColors.indexOf(c) >= 0; }\n\nfunction slimeMixParts(need) {\n  for (var k in CFG.mixPairs) if (CFG.mixPairs[k] === need) return k.split('+');\n  return null;\n}\n\nfunction slimeCoachPlan(grid, orders, want, opts) {\n  var rows = grid.length, cols = grid[0].length, loose = [], r, c, i, k, oi;\n  var kind = opts && opts.kind, skip = opts && opts.skip;\n  for (r = 0; r < rows; r++) for (c = 0; c < cols; c++) {\n    var t0 = grid[r][c