le = st === 'equipped' ? VIEW.ok : VIEW.inkSoft;\n      ctx.font = '700 11px system-ui, sans-serif';\n      ctx.fillText(word, box.x + box.w - ROW_PAD, box.y + rh / 2);\n      rightW = ctx.measureText(word).width;\n    } else if (st === 'locked') {\n      rightW = paintLockChip(box.x + box.w - ROW_PAD, box.y + rh / 2, sk.rank);\n    } else {\n      rightW = paintGooChip(box.x + box.w - ROW_PAD, box.y + rh / 2, sk.price);\n    }\n    ctx.restore();\n    ctx.textBaseline = 'alphabetic';\n    uiBox('row', cardHit(box), sk.name + '/' + st,\n          (ROW_TEXT_X + nameW + ROW_GAP + rightW + ROW_PAD) * CARD_T.s);\n    rows.push({ kind: 'skin', id: sk.id, box: cardHit(box) });\n  }\n\n  if (!p.compact) tagText('UPGRADES', p.rightX + 6, p.modsY - 10, VIEW.inkSoft, 'left');\n  for (i = 0; i < SHOP_MOD_IDS.length; i++) {\n    var modId = SHOP_MOD_IDS[i], mod = RUN_MODS[modId], mst = shopModState(save, modId);\n    var mbox = { x: p.rightX, y: p.modsY + i * p.step, w: p.rightW, h: rh };\n    ctx.save();\n    var mps = pressScale('row:' + modId, now);\n    ctx.translate(mbox.x + mbox.w / 2, mbox.y + mbox.h / 2); ctx.scale(mps, mps);\n    ctx.translate(-(mbox.x + mbox.w / 2), -(mbox.y + mbox.h / 2));\n    paintShopRow(mbox, mst === 'owned' ? 'equipped' : (mst === 'short' ? 'short' : 'plain'), now);\n    if (mst === 'short') ctx.globalAlpha *= 0.42;\n    paintModIcon(modId, mbox.x + 16, mbox.y + rh / 2);\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'middle';\n    ctx.fillStyle = VIEW.ink;\n    ctx.font = '800 13px system-ui, sans-serif';\n    ctx.fillText(mod.name, mbox.x + MOD_TEXT_X, mbox.y + rh / 2 - (p.compact ? 0 : 7));\n    var modW = ctx.measureText(mod.name).width, mRight;\n    if (!p.compact) {\n      ctx.fillStyle = VIEW.inkSoft;\n      ctx.font = '600 11px system-ui, sans-serif';\n      ctx.fillText(mod.text, mbox.x + MOD_TEXT_X, mbox.y + rh / 2 + 8);\n      modW = Math.max(modW, ctx.measureText(mod.text).width);\n    }\n    ctx.globalAlpha = 1;\n    if (mst =