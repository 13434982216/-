            "text": "<!-- @format -->\n\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover\" />\n    <title>Slime Works</title>\n    <script type=\"text/javascript\">\n      document.domain = \"7k7k.com\";\n    </script>\n    <link rel=\"shortcut icon\" href=\"./favicon.ico\" />\n\n    <link rel=\"stylesheet\" href=\"style.css\" />\n\n    <link rel=\"preload\" as=\"image\" href=\"assets/room_land.jpg\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/room_port.jpg\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/op.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/drop.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/props.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/pipe.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/board.jpg\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/goo.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/pump.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/sump.png\" />\n    <link rel=\"preload\" as=\"image\" href=\"assets/ui.png\" />\n    <script>\n      (function (w, d) {\n        var S = null,\n          ready = false,\n          playing = false,\n          want = null,\n          booted = false,\n          loading = false,\n          waiters = [];\n        function q(n) {\n          if (w.slimeSdkEvent) w.slimeSdkEvent(n);\n          else (w.__sdkQueue = w.__sdkQueue || []).push(n);\n        }\n        function safe(f) {\n          try {\n            return f();\n          } catch (e) {\n            return undefined;\n          }\n        }\n        function flush() {\n          var ws = waiters;\n          waiters = [];\n          for (var i = 0; i < ws.length; i++) safe(ws[i]);\n        }\n        function off() {\n          S = false;\n          ready = false;\n          flush();\n