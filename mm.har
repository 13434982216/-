            "mimeType": "application/javascript",
            "text": "if (typeof document !== 'undefined') {\n\n  var audioCtx = null;\n\n  function ensureAudio() {\n    if (!audioCtx) {\n      try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }\n      catch (e) { audioCtx = null; }\n    }\n\n    if (audioCtx && audioCtx.state === 'suspended') {\n      try {\n        var pr = audioCtx.resume();\n        if (pr && pr.then) pr.then(null, function () {});\n      } catch (e) {}\n    }\n  }\n  var audioMaster = null, sfxBus = null, musicBus = null;\n\n  var NET_MUTE = false;\n\n  function audioNetMute(on) { NET_MUTE = !!on; audioSetLevels(); }\n  function audioSfxLevel() { return NET_MUTE || (save && save.sfxOn === false) ? 0 : 1; }\n  function audioMusicLevel() { return NET_MUTE || (save && save.musicOn === false) ? 0 : 1; }\n\n  function audioBus() {\n    if (!audioCtx) return null;\n    if (!audioMaster) {\n      try {\n        var t = audioCtx.currentTime;\n        var comp = audioCtx.createDynamicsCompressor();\n        comp.threshold.setValueAtTime(-16, t);\n        comp.ratio.setValueAtTime(8, t);\n        comp.attack.setValueAtTime(0.004, t);\n        comp.release.setValueAtTime(0.18, t);\n        audioMaster = audioCtx.createGain();\n        audioMaster.gain.setValueAtTime(1, t);\n        audioMaster.connect(comp); comp.connect(audioCtx.destination);\n        sfxBus = audioCtx.createGain();\n        musicBus = audioCtx.createGain();\n        sfxBus.gain.setValueAtTime(audioSfxLevel(), t);\n        musicBus.gain.setValueAtTime(audioMusicLevel(), t);\n        sfxBus.connect(audioMaster); musicBus.connect(audioMaster);\n      } catch (e) { audioMaster = null; }\n    }\n    return sfxBus;\n  }\n\n  function audioMusicBus() { audioBus(); return musicBus; }\n\n  function audioSetLevels() {\n    var bus = audioBus(); if (!bus) return;\n    var t = audioCtx.currentTime;\n    sfxBus.gain.setTargetAtTime(audioSfxLevel(), t, 0.04);\n    musicBus.gain.setTargetAtTime(audioMusicLevel(), t, 0.04);\n  }\n\n  function audioSilence() {\n    var bus = audioBus(); if (!bus) return;\n    var t = audioCtx.currentTime;\n    sfxBus.gain.setTargetAtTime(0, t, 0.04);\n    musicBus.gain.setTargetAtTime(0, t, 0.04);\n  }\n\n  var noiseBuf = null;\n\n  function audioNoise() {\n    if (!audioCtx) return null;\n    try {\n      if (!noiseBuf) {\n        var n = Math.floor(audioCtx.sampleRate * 2);\n        noiseBuf = audioCtx.createBuffer(1, n, audioCtx.sampleRate);\n        var d = noiseBuf.getChannelData(0);\n        for (var i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;\n      }\n      var src = audioCtx.createBufferSource();\n      src.buffer = noiseBuf; src.loop = true;\n      return src;\n    } catch (e) { return null; }\n  }\n\n  function tone(freq, dur, type, vol, freqEnd, delay) {\n    if (!audioCtx || save.sfxOn === false) return;\n    var dB = -12;\n    var amp = Math.pow(10, dB / 20) * (vol || 0.5);\n    var t0 = audioCtx.currentTime + (delay || 0);\n    var osc = audioCtx.createOscillator(), g = audioCtx.createGain();\n    osc.type = type || 'sine';\n    osc.frequency.setValueAtTime(freq, t0);\n    if (freqEnd) osc.frequency.exponentialRampToValueAtTime(freqEnd, t0 + dur);\n    g.gain.setValueAtTime(0.0001, t0);\n    g.gain.exponentialRampToValueAtTime(amp, t0 + 0.012);\n    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n    osc.connect(g); g.connect(audioBus() || audioCtx.destination);\n    osc.start(t0); osc.stop(t0 + dur + 0.03);\n  }\n\n  function noiseBurst(dur, f0, f1, vol, type, delay) {\n    if (!audioCtx || save.sfxOn === false) return;\n    var src = audioNoise();\n    if (!src) return;\n    try {\n      var t0 = audioCtx.currentTime + (delay || 0);\n      var f = audioCtx.createBiquadFilter();\n      f.type = type || 'bandpass';\n      f.Q.setValueAtTime(1.1, t0);\n      f.frequency.setValueAtTime(f0, t0);\n      f.frequency.exponentialRampToValueAtTime(Math.max(40, f1), t0 + dur);\n      var g = audioCtx.createGain();\n      var amp = Math.pow(10, -12 / 20) * (vol || 0.4);\n      g.gain.setValueAtTime(0.0001, t0);\n      g.gain.exponentialRampToValueAtTime(amp, t0 + 0.008);\n      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n      src.connect(f); f.connect(g); g.connect(audioBus() || audioCtx.destination);\n      src.start(t0); src.stop(t0 + dur + 0.05);\n    } catch (e) {}\n  }\n\n  function thump(freq, dur, vol, delay) {\n    if (save.sfxOn === false) return;\n    var bus = audioBus(); if (!bus) return;\n    var t0 = audioCtx.currentTime + (delay || 0);\n    var o = audioCtx.createOscillator(), g = audioCtx.createGain(), lp = audioCtx.createBiquadFilter();\n    o.type = 'sine'; o.frequency.setValueAtTime(freq, t0); o.frequency.exponentialRampToValueAtTime(Math.max(20, freq * 0.35), t0 + dur);\n    lp.type = 'lowpass'; lp.frequency.value = 900;\n    g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(Math.pow(10, -12 / 20) * (vol || 0.6), t0 + 0.004);\n    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n    o.connect(lp); lp.connect(g); g.connect(bus); o.start(t0); o.stop(t0 + dur + 0.05);\n  }\n\n  var sfxRotate = function () { tone(220, 0.08, 'square', 0.5); };\n  var sfxFill = function () { tone(300, 0.15, 'sine', 0.5, 600); };\n  var sfxWin = function () {\n    var p = [261.63, 293.66, 329.63, 392.0, 440.0];\n    var sel = [p[0], p[2], p[4]];\n    for (var i = 0; i < 3; i++) tone(sel[i], 0.17, 'triangle', 0.6, 0, i * 0.12);\n  };\n  var sfxError = function () { tone(110, 0.2, 'sawtooth', 0.5); };\n\n}\n"
