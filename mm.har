            "mimeType": "application/javascript",
            "text": "var SHOP_SKIN_KEYS = ['wall', 'tileA', 'tileB', 'grout', 'floor', 'plate', 'metal', 'rim'];\n\nvar SKIN_TINT = { works: 0, rust: 0.55, chrome: 0.5, night: 0.6 };\n\nvar SHOP_LOCKED_KEYS = ['goo', 'sludge', 'ink', 'inkDim', 'alarm', 'lamp'];\n\nvar SHOP_SKINS = [\n  {\n    id: 'works', name: 'WORKS', price: 0,\n    patch: { wall: '#0d1512', tileA: '#16211d', tileB: '#131d1a', grout: '#080d0b',\n             floor: '#0a110e', plate: '#1e2a25', metal: '#63736d', rim: '#2b3a35' }\n  },\n  {\n    id: 'rust', name: 'RUST', price: 120,\n    patch: { wall: '#150f0c', tileA: '#241812', tileB: '#1e130f', grout: '#0d0705',\n             floor: '#120c09', plate: '#2f1f17', metal: '#a8785a', rim: '#432c20' }\n  },\n  {\n    id: 'chrome', name: 'CHROME', price: 240, rank: 3,\n    patch: { wall: '#101418', tileA: '#1c242b', tileB: '#182027', grout: '#0a0e12',\n             floor: '#0d1216', plate: '#26313a', metal: '#9aa8b4', rim: '#2f3a44' }\n  },\n  {\n    id: 'night', name: 'NIGHT', price: 400, rank: 5,\n    patch: { wall: '#0b0d1a', tileA: '#151a2e', tileB: '#111527', grout: '#06070f',\n             floor: '#090b16', plate: '#1c2340', metal: '#6d78a8', rim: '#2b3358' }\n  }\n];\n\nvar RANKS = [\n  { xp: 0, name: 'TRAINEE' }, { xp: 5000, name: 'OPERATOR' }, { xp: 15000, name: 'FOREMAN' },\n  { xp: 40000, name: 'ENGINEER' }, { xp: 90000, name: 'SUPERVISOR' }, { xp: 180000, name: 'CHIEF' },\n  { xp: 320000, name: 'DIRECTOR' }, { xp: 520000, name: 'MASTER' }, { xp: 800000, name: 'LEGEND' },\n  { xp: 1200000, name: 'SLIME LORD' }\n];\nfunction rankOf(xp) { var i = 0; while (i + 1 < RANKS.length && xp >= RANKS[i + 1].xp) i++; return i; }\nfunction rankNext(xp) {\n  var i = rankOf(xp);\n  return i + 1 < RANKS.length ? { need: RANKS[i + 1].xp, have: xp, name: RANKS[i + 1].name } : null;\n}\n\nvar SHOP_ITEMS = [\n  { id: 'purge', name: 'FLUSH', price: 60, cap: 5 }\n];\n\nvar SHOP_REVIVE_MAX = 3;\n\nvar RUN_MODS = {\n  secondFlush: { price: 260, name: 'SECOND FLUSH', text: 'two free flushes per run' }\n};\n\nvar SHOP_MOD_IDS = ['secondFlush'];\n\nvar SHOP_REFUNDS = { bigSump: 200, slowStart: 150 };\n\nvar TOOLS = {\n  hold:    { price: 180, cd: 45, key: '1', name: 'HOLD',    text: 'freeze all order timers for 5 s' },\n  drain:   { price: 220, cd: 60, key: '2', name: 'DRAIN',   text: 'drop the sump by a quarter' },\n  repaint: { price: 320, rank: 3, key: '3', name: 'REPAINT', text: 'tap a pump: next colour, once/shift' }\n};\nvar SHOP_TOOL_IDS = ['hold', 'drain', 'repaint'];\n\nfunction shopSkin(id) {\n  for (var i = 0; i < SHOP_SKINS.length; i++) if (SHOP_SKINS[i].id === id) return SHOP_SKINS[i];\n  return null;\n}\n\nfunction shopItem(id) {\n  for (var i = 0; i < SHOP_ITEMS.length; i++) if (SHOP_ITEMS[i].id === id) return SHOP_ITEMS[i];\n  return null;\n}\n\nfunction finiteNonNeg(v) { return typeof v === 'number' && isFinite(v) && v >= 0; }\n\nfunction shopNormalize(sv) {\n  if (typeof sv.muted === 'boolean') { sv.musicOn = !sv.muted; sv.sfxOn = !sv.muted; delete sv.muted; }\n  if (typeof sv.musicOn !== 'boolean') sv.musicOn = true;\n  if (typeof sv.sfxOn !== 'boolean') sv.sfxOn = true;\n  if (!finiteNonNeg(sv.goo)) sv.goo = 0;\n  if (!finiteNonNeg(sv.goalsDone)) sv.goalsDone = 0;\n  if (!finiteNonNeg(sv.xp)) sv.xp = 0;\n  if (!sv.daily || typeof sv.daily !== 'object' || !finiteNonNeg(sv.daily.best)) sv.daily = { key: '', best: 0 };\n  if (!sv.items || typeof sv.items !== 'object') sv.items = {};\n  for (var i = 0; i < SHOP_ITEMS.length; i++) {\n    var it = SHOP_ITEMS[i], have = sv.items[it.id];\n    sv.items[it.id] = (typeof have === 'number' && have > 0) ? Math.min(it.cap, Math.floor(have)) : 0;\n  }\n  var mods = {}, k;\n  if (sv.mods && typeof sv.mods === 'object')\n    for (k in SHOP_REFUNDS) if (sv.mods[k]) sv.goo += SHOP_REFUNDS[k];\n  for (k in RUN_MODS) mods[k] = sv.mods && sv.mods[k] ? 1 : 0;\n  sv.mods = mods;\n  var tools = {};\n  for (k in TOOLS) tools[k] = sv.tools && sv.tools[k] ? 1 : 0;\n  sv.tools = tools;\n  if (!Array.isArray(sv.skins)) sv.skins = [];\n  if (sv.skins.indexOf('works') < 0) sv.skins.unshift('works');\n  sv.skins = sv.skins.filter(function (id) { return !!shopSkin(id); });\n  if (!shopSkin(sv.skin) || sv.skins.indexOf(sv.skin) < 0) sv.skin = 'works';\n  if (typeof sv.coachDone !== 'boolean') sv.coachDone = (sv.slimeRuns || 0) > 0;\n  if (typeof sv.tutorialDone !== 'boolean') sv.tutorialDone = (sv.slimeRuns || 0) > 0;\n  if (!sv.hints || typeof sv.hints !== 'object') sv.hints = { deliver: 0, sump: 0, mix: 0 };\n  if (sv.hints.mix == null) sv.hints.mix = 0;\n  if (sv.hints.tool == null) sv.hints.tool = 0;\n  return sv;\n}\n\nfunction shopOwned(sv, id) { return !!(sv.skins && sv.skins.indexOf(id) >= 0); }\n\nfunction shopHave(sv, id) { return (sv.items && sv.items[id]) || 0; }\n\nfunction shopSkinState(sv, id) {\n  if (sv.skin === id) return 'equipped';\n  if (shopOwned(sv, id)) return 'owned';\n  var sk = shopSkin(id);\n  if (!sk) return 'none';\n  if (sk.rank && rankOf(sv.xp || 0) < sk.rank) return 'locked';\n  return sv.goo >= sk.price ? 'buy' : 'short';\n}\n\nfunction shopItemState(sv, id) {\n  var it = shopItem(id);\n  if (!it) return 'none';\n  if (shopHave(sv, id) >= it.cap) return 'full';\n  return sv.goo >= it.price ? 'buy' : 'short';\n}\n\nfunction shopBuySkin(sv, id) {\n  if (shopSkinState(sv, id) !== 'buy') return false;\n  sv.goo -= shopSkin(id).price;\n  sv.skins.push(id);\n  sv.skin = id;\n  return true;\n}\n\nfunction shopEquipSkin(sv, id) {\n  if (shopSkinState(sv, id) !== 'owned') return false;\n  sv.skin = id;\n  return true;\n}\n\nfunction shopBuyItem(sv, id) {\n  if (shopItemState(sv, id) !== 'buy') return false;\n  sv.goo -= shopItem(id).price;\n  sv.items[id] = shopHave(sv, id) + 1;\n  return true;\n}\n\nfunction shopSpendItem(sv, id) {\n  if (shopHave(sv, id) <= 0) return false;\n  sv.items[id]--;\n  return true;\n}\n\nfunction shopModState(sv, id) {\n  var m = RUN_MODS[id];\n  if (!m) return 'none';\n  if (sv.mods && sv.mods[id]) return 'owned';\n  return sv.goo >= m.price ? 'buy' : 'short';\n}\n\nfunction shopBuyMod(sv, id) {\n  if (shopModState(sv, id) !== 'buy') return false;\n  sv.goo -= RUN_MODS[id].price;\n  sv.mods[id] = 1;\n  return true;\n}\n\nfunction shopToolState(sv, id) {\n  var t = TOOLS[id];\n  if (!t) return 'none';\n  if (sv.tools && sv.tools[id]) return 'owned';\n  if (t.rank && rankOf(sv.xp || 0) < t.rank) return 'locked';\n  return sv.goo >= t.price ? 'buy' : 'short';\n}\n\nfunction shopBuyTool(sv, id) {\n  if (shopToolState(sv, id) !== 'buy') return false;\n  sv.goo -= TOOLS[id].price;\n  sv.tools[id] = 1;\n  return true;\n}\n\nfunction shopWanted(sv) {\n  var out = [], i, id;\n  for (i = 0; i < SHOP_SKINS.length; i++)\n    if (shopSkinState(sv, SHOP_SKINS[i].id) === 'buy' || shopSkinState(sv, SHOP_SKINS[i].id) === 'short')\n      out.push({ kind: 'skin', id: SHOP_SKINS[i].id, name: SHOP_SKINS[i].name, price: SHOP_SKINS[i].price });\n  for (i = 0; i < SHOP_TOOL_IDS.length; i++) {\n    id = SHOP_TOOL_IDS[i];\n    if (shopToolState(sv, id) === 'buy' || shopToolState(sv, id) === 'short')\n      out.push({ kind: 'tool', id: id, name: TOOLS[id].name, price: TOOLS[id].price });\n  }\n  for (i = 0; i < SHOP_MOD_IDS.length; i++) {\n    id = SHOP_MOD_IDS[i];\n    if (shopModState(sv, id) === 'buy' || shopModState(sv, id) === 'short')\n      out.push({ kind: 'mod', id: id, name: RUN_MODS[id].name, price: RUN_MODS[id].price });\n  }\n  out.sort(function (a, b) { return a.price - b.price; });\n  return out;\n}\n\nfunction shopNextGoal(sv) {\n  var w = shopWanted(sv);\n  if (!w.length) return null;\n  var g = w[0];\n  g.short = Math.max(0, g.price - (sv.goo || 0));\n  return g;\n}\n\nfunction shopAffordable(sv) {\n  var w = shopWanted(sv);\n  return w.length && w[0].price <= (sv.goo || 0) ? w[0].id : null;\n}\n\nvar ADS_MIDROLL_GAP_MS = 180000;\nvar ADS_MIDROLL_MIN_RUN_S = 60;\n\nfunction adsMidrollOk(nowMs, lastAtMs, runT) {\n  if (!(runT >= ADS_MIDROLL_MIN_RUN_S)) return false;\n  return nowMs - lastAtMs >= ADS_MIDROLL_GAP_MS;\n}\n\nvar SHOP_EARN_K = 0.19;\n\nfunction shopEarned(score) {\n  if (!finiteNonNeg(score)) score = 0;\n  return Math.max(1, Math.round(SHOP_EARN_K * Math.sqrt(score)));\n}\n"
