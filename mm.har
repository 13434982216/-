            "size": 5391,
            "mimeType": "application/javascript",
            "text": "const HAND = [\n\n  {\n    size: 3, par: 2,\n    grid: [\n      [ {type:'source', rot:0, fixed:true, color:'R'}, {type:'empty', rot:0, fixed:true},          {type:'empty', rot:0, fixed:true} ],\n      [ {type:'elbow',  rot:0, fixed:false},           {type:'elbow', rot:2, fixed:false},         {type:'empty', rot:0, fixed:true} ],\n      [ {type:'empty',  rot:0, fixed:true},            {type:'output', rot:0, fixed:true, need:'R'}, {type:'empty', rot:0, fixed:true} ]\n    ]\n  },\n\n  {\n    size: 3, par: 3,\n    grid: [\n      [ {type:'source', rot:0, fixed:true, color:'R'}, {type:'empty', rot:0, fixed:true},            {type:'source', rot:0, fixed:true, color:'Y'} ],\n      [ {type:'elbow',  rot:0, fixed:false},           {type:'tee',   rot:1, fixed:false},           {type:'elbow',  rot:3, fixed:false} ],\n      [ {type:'empty',  rot:0, fixed:true},            {type:'output', rot:0, fixed:true, need:'O'}, {type:'empty', rot:0, fixed:true} ]\n    ]\n  },\n\n  {\n    size: 4, par: 3,\n    grid: [\n      [ {type:'empty',  rot:0, fixed:true},            {type:'empty',    rot:0, fixed:true},           {type:'empty', rot:0, fixed:true},             {type:'source', rot:0, fixed:true, color:'R'} ],\n      [ {type:'output', rot:1, fixed:true, need:'Y'},  {type:'elbow',    rot:2, fixed:false},          {type:'elbow', rot:1, fixed:false},            {type:'elbow',  rot:3, fixed:false} ],\n      [ {type:'empty',  rot:0, fixed:true},            {type:'straight', rot:0, fixed:false},          {type:'output', rot:0, fixed:true, need:'R'},  {type:'empty',  rot:0, fixed:true} ],\n      [ {type:'empty',  rot:0, fixed:true},            {type:'source',   rot:2, fixed:true, color:'Y'}, {type:'empty', rot:0, fixed:true},            {type:'empty',  rot:0, fixed:true} ]\n    ]\n  },\n\n  {\n    size: 4, par: 3,\n    grid: [\n      [ {type:'empty', rot:0, fixed:true},              {type:'source', rot:0, fixed:true, color:'B'}, {type:'empty', rot:0, fixed:true},  {type:'empty', rot:0, fixed:true} ],\n      [ {type:'elbow', rot:1, fixed:false},             {type:'cross',  rot:0, fixed:true},           {type:'straight', rot:1, fixed:false}, {type:'elbow', rot:2, fixed:false} ],\n      [ {type:'source', rot:2, fixed:true, color:'R'},  {type:'straight', rot:0, fixed:false},         {type:'empty', rot:0, fixed:true},  {type:'straight', rot:0, fixed:false} ],\n      [ {type:'empty', rot:0, fixed:true},              {type:'output', rot:0, fixed:true, need:'B'},  {type:'empty', rot:0, fixed:true},  {type:'output', rot:0, fixed:true, need:'R'} ]\n    ]\n  },\n\n  {\n    size: 4, par: 3,\n    grid: [\n      [ {type:'source', rot:0, fixed:true, color:'R'}, {type:'empty', rot:0, fixed:true},     {type:'source', rot:0, fixed:true, color:'B'}, {type:'empty', rot:0, fixed:true} ],\n      [ {type:'tee',    rot:0, fixed:false},           {type:'straight', rot:1, fixed:false}, {type:'cross', rot:0, fixed:true},            {type:'elbow', rot:2, fixed:false} ],\n      [ {type:'source', rot:2, fixed:true, color:'Y'}, {type:'empty', rot:0, fixed:true},     {type:'straight', rot:0, fixed:false},         {type:'straight', rot:0, fixed:false} ],\n      [ {type:'empty',  rot:0, fixed:true},            {type:'empty', rot:0, fixed:true},     {type:'output', rot:0, fixed:true, need:'B'},  {type:'output', rot:0, fixed:true, need:'O'} ]\n    ]\n  }\n];\n\nfunction seededRandom(seed) {\n  var a = seed >>> 0;\n  return function () {\n    a |= 0; a = (a + 0x6D2B79F5) | 0;\n    var t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nfunction curve(n) {\n  for (var i = 0; i < DIFFICULTY.length; i++)\n    if (n <= DIFFICULTY[i].доУровня) return DIFFICULTY[i].difficulty;\n  return DIFFICULTY[DIFFICULTY.length - 1].difficulty;\n}\n\nfunction genCloneGrid(g) {\n  return coreCloneGrid(g);\n}\n\nvar LEVELS = new Proxy({}, {\n  get: function (t, prop) {\n    if (prop === 'length') return 100000;\n    if (prop === 'forEach') return function (cb) { for (var i = 0; i < HAND.length; i++) cb(HAND[i], i); };\n    var i = Number(prop);\n    if (prop !== '' && !isNaN(i)) {\n      if (i >= 0 && i < HAND.length) return HAND[i];\n      if (i >= HAND.length) return makeLevel(i + 1);\n    }\n    return t[prop];\n  }\n});\n\nvar NET_CACHE = {};\n\nfunction netLevel(seed, diff) {\n  var key = seed + '|' + JSON.stringify(diff);\n  var hit = NET_CACHE[key];\n  if (hit === undefined) {\n    hit = null;\n    for (var k = 0; k < 200; k++) {\n      var lvl = buildNetLevel(seededRandom((seed + k * 7919) >>> 0), diff);\n      if (lvl) { hit = lvl; break; }\n    }\n    NET_CACHE[key] = hit;\n  }\n  if (!hit) return null;\n  var g = genCloneGrid(hit._solution);\n  return { size: hit.size, grid: g, par: hit.par, _solution: g, attempts: hit.attempts };\n}\n\nfunction makeLevel(n) {\n  var lvl = netLevel(n, curve(n));\n  if (!lvl) lvl = { size: HAND[0].grid.length, grid: HAND[0].grid, par: 3, _solution: HAND[0].grid };\n  return { size: lvl.size, grid: genCloneGrid(lvl._solution), par: lvl.par, _solution: genCloneGrid(lvl._solution) };\n}\n\nfunction getDailyLevel(dateKeyStr) {\n  var dl = CFG.ui.dailyLevel;\n  var lvl = netLevel(parseInt(dateKeyStr, 10), curve(dl));\n  if (!lvl) lvl = { size: HAND[0].grid.length, grid: HAND[0].grid, par: 3, _solution: HAND[0].grid };\n  return { size: lvl.size, grid: genCloneGrid(lvl._solution), par: lvl.par, _solution: genCloneGrid(lvl._solution) };\n}\n\n"
