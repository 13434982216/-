n}\n\nfunction drawDanger(now) {\n  var k = scene.run.contam;\n  if (k < 0.5) return;\n  var t = (k - 0.5) / 0.5;\n  var a = Math.min(0.42, Math.pow(t, 1.4) * (0.20 + (0.18 + 0.16 * t) * osc01(now, PULSE.alarm)));\n  var band = Math.max(26, Math.min(vw, vh) * (0.07 + 0.05 * t));\n  var g;\n  ctx.save();\n  g = ctx.createLinearGradient(0, 0, 0, band);\n  g.addColorStop(0, rgba(VIEW.alarm, a)); g.addColorStop(1, rgba(VIEW.alarm, 0));\n  ctx.fillStyle = g; ctx.fillRect(0, 0, vw, band);\n  g = ctx.createLinearGradient(0, vh, 0, vh - band);\n  g.addColorStop(0, rgba(VIEW.alarm, a)); g.addColorStop(1, rgba(VIEW.alarm, 0));\n  ctx.fillStyle = g; ctx.fillRect(0, vh - band, vw, band);\n  g = ctx.createLinearGradient(0, 0, band, 0);\n  g.addColorStop(0, rgba(VIEW.alarm, a)); g.addColorStop(1, rgba(VIEW.alarm, 0));\n  ctx.fillStyle = g; ctx.fillRect(0, 0, band, vh);\n  g = ctx.createLinearGradient(vw, 0, vw - band, 0);\n  g.addColorStop(0, rgba(VIEW.alarm, a)); g.addColorStop(1, rgba(VIEW.alarm, 0));\n  ctx.fillStyle = g; ctx.fillRect(vw - band, 0, band, vh);\n  ctx.restore();\n}\n\nvar CARD_EDGE = 14;\nvar CARD_T = { s: 1, x: 0, y: 0 };\n\nvar CARD_IN_MS = 220, CARD_OUT_MS = 170;\nvar ghosting = false, ghostK = 0;\n\nfunction cardPose(now) {\n  if (ghosting) return { s: 1 - 0.04 * ghostK, a: 1 - ghostK };\n  if (!SCENE_T.at) return { s: 1, a: 1 };\n  var k = Math.max(0, Math.min(1, (now - SCENE_T.at) / CARD_IN_MS)), e = 1 - Math.pow(1 - k, 3);\n  return { s: 0.94 + 0.06 * e, a: e };\n}\n\nfunction cardOpen(w, h) {\n  var s = (w > 0 && h > 0) ? Math.min(1, (vh - CARD_EDGE * 2) / h, (vw - CARD_EDGE * 2) / w) : 1;\n  CARD_T.s = s;\n  CARD_T.x = Math.round((vw - w * s) / 2);\n  CARD_T.y = Math.round((vh - h * s) / 2);\n  ctx.save();\n  ctx.translate(CARD_T.x, CARD_T.y);\n  ctx.scale(s, s);\n  var p = cardPose(performance.now());\n  ctx.translate(w / 2, h / 2); ctx.scale(p.s, p.s); ctx.translate(-w / 2, -h / 2);\n  ctx.globalAlpha = p.a;\n  return { x: 0, y: 0, w: w, h: h };\n}\n\nfunction cardClose() { ctx.restore(); ctx.globalAlpha = 1; CARD_T = { s: 1, x: 0, y: 0 }; }\n\nvar VEIL = { title: 0.42, shop: 0.74, over: 0.80, pause: 0.62 };\nvar veil = 0, veilOn = false;\n\nfunction veilTarget() {\n  if (MODE === 'over') return overCardUp() ? VEIL.over : 0;\n  if (MODE === 'pause') return PAUSE.by === 'ad' ? 0 : VEIL.pause;\n  return VEIL[MODE] || 0;\n}\n\nfunction drawVeil(dt) {\n  var want = veilTarget();\n  if (!veilOn) { veil = want; veilOn = true; }\n  else veil += (want - veil) * (1 - Math.exp(-dt / 0.075));\n  if (Math.abs(want - veil) < 0.004) veil = want;\n  if (veil < 0.005) return;\n  ctx.fillStyle = 'rgba(5,9,7,' + veil.toFixed(3) + ')';\n  ctx.fillRect(0, 0, vw, vh);\n}\n\nfunction drawGhostCard(now) {\n  if (!SCENE_T.at) return;\n  var age = now - SCENE_T.at, from = SCENE_T.from;\n  if (age < 0 || age >= CARD_OUT_MS) return;\n  if (from !== 'title' && from !== 'shop' && from !== 'over' && from !== 'pause') return;\n  if (from === 'pause' && !PAUSE.hadCard) return;\n  ghosting = true; ghostK = age / CARD_OUT_MS;\n  if (from === 'title') drawTitleCard(now);\n  else if (from === 'shop') drawShopCard(now);\n  else if (from === 'pause') drawPauseCard(now);\n  else drawOverCard(now, SCENE_T.run);\n  ghosting = false;\n}\n\nfunction drawPauseCard(now) {\n  var W = Math.min(300, vw - CARD_EDGE * 2), H = 282;\n  var b = cardOpen(W, H);\n  paintCard(b);\n  paintCardTop(b, 'PAUSED');\n  var bw = W - 44, bx = 22;\n  var resume = { x: bx, y: 70, w: bw, h: 46 };\n  var restart = { x: bx, y: 126, w: bw, h: 46 };\n  var music = { x: bx, y: 182, w: bw, h: 40 };\n  var sfx = { x: bx, y: 228, w: bw, h: 40 };\n  paintButton(resume, 'RESUME', 'go', now, true, 'resume');\n  paintButton(restart, 'RESTART', 'off', now, false, 'restart');\n  paintButton(music, save.musicOn ? 'MUSIC ON' : 'MUSIC OFF', 'off', now, false, 'music');\n  paintButton(sfx, save.sfxOn ? 'SOUND ON' : 'SOUND OFF', 'off', now, false, 'sfx');\n  if (!ghosting) { scene.pauseBtns = { re